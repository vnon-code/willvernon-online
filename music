    <script>
        // Mobile Menu Logic
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const closeMenuBtn = document.getElementById('close-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const mobileLinks = document.querySelectorAll('.mobile-link');

        function toggleMenu() {
            mobileMenu.classList.toggle('hidden');
            mobileMenu.classList.toggle('flex');
            document.body.classList.toggle('overflow-hidden');
        }

        mobileMenuBtn.addEventListener('click', toggleMenu);
        closeMenuBtn.addEventListener('click', toggleMenu);
        mobileLinks.forEach(link => link.addEventListener('click', toggleMenu));

        // Procedural Audio Waveform / Frequencies Visualizer Simulation
        const canvas = document.getElementById('audio-canvas');
        const ctx = canvas.getContext('2d');
        
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = canvas.parentElement.offsetHeight;
        
        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = canvas.parentElement.offsetHeight;
        });

        let particles = [];
        for (let i = 0; i < 40; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                size: Math.random() * 2 + 1,
                speedY: (Math.random() - 0.5) * 0.4,
                speedX: (Math.random() - 0.5) * 0.4,
                freq: Math.random() * 0.05 + 0.01,
                amplitude: Math.random() * 20 + 5
            });
        }

        let phase = 0;
        function drawVisualizer() {
            ctx.clearRect(0, 0, width, height);
            
            // Render ambient synthetic frequency grids
            ctx.strokeStyle = 'rgba(217, 28, 28, 0.05)';
            ctx.lineWidth = 1;
            ctx.beginPath();
            for (let i = 0; i < width; i += 40) {
                ctx.moveTo(i, 0);
                ctx.lineTo(i, height);
            }
            for (let j = 0; j < height; j += 40) {
                ctx.moveTo(0, j);
                ctx.lineTo(width, j);
            }
            ctx.stroke();

            // Render flowing sub-bass frequency waves
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(217, 28, 28, 0.25)';
            ctx.lineWidth = 1.5;
            for (let i = 0; i < width; i++) {
                let wave1 = Math.sin(i * 0.003 + phase) * 60;
                let wave2 = Math.cos(i * 0.008 - phase * 0.5) * 20;
                let y = height / 2 + wave1 + wave2;
                if (i === 0) ctx.moveTo(i, y);
                else ctx.lineTo(i, y);
            }
            ctx.stroke();

            // Render mid-frequency secondary wave
            ctx.beginPath();
            ctx.strokeStyle = 'rgba(217, 28, 28, 0.1)';
            ctx.lineWidth = 1;
            for (let i = 0; i < width; i++) {
                let wave1 = Math.sin(i * 0.01 + phase * 2) * 30;
                let y = height / 2 + wave1;
                if (i === 0) ctx.moveTo(i, y);
                else ctx.lineTo(i, y);
            }
            ctx.stroke();

            // Particles behaving as spatial frequency nodes
            particles.forEach(p => {
                p.y += p.speedY;
                p.x += p.speedX;
                
                // Boundaries
                if (p.y < 0 || p.y > height) p.speedY *= -1;
                if (p.x < 0 || p.x > width) p.speedX *= -1;

                let sizeOffset = Math.sin(phase * p.freq) * p.amplitude;
                
                ctx.fillStyle = 'rgba(217, 28, 28, 0.5)';
                ctx.beginPath();
                ctx.arc(p.x, p.y + sizeOffset * 0.1, p.size, 0, Math.PI * 2);
                ctx.fill();
            });

            phase += 0.01;
            requestAnimationFrame(drawVisualizer);
        }
        drawVisualizer();
    </script>
