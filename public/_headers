# Cloudflare Workers static-assets header rules.
# __INLINE_HASHES__ is replaced at build by scripts/csp-hashes.mjs with the SHA-256 of Nuxt's two inline scripts
# (the importmap and window.__NUXT__.config), which change with every buildId.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com __INLINE_HASHES__; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.willvernon.online; media-src 'self' https://assets.willvernon.online; font-src 'self'; connect-src 'self' https://formspree.io https://cloudflareinsights.com https://static.cloudflareinsights.com https://assets.willvernon.online; frame-src https://w.soundcloud.com https://open.spotify.com https://www.youtube.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests;
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate

# '! Cache-Control' detaches the value inherited from /* (Cloudflare merges
# every matching rule and would otherwise comma-join the two values).
/_nuxt/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/styleguide*
  X-Robots-Tag: noindex
