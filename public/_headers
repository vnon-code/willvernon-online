# Cloudflare Workers static-assets header rules.
# Origins allowed below are exactly the ones in use, confirmed against
# redesign/content/assets.json and legacy/*.html:
#   - images/audio: this origin (/img, /audio) + https://assets.willvernon.online (R2)
#   - embeds: w.soundcloud.com, open.spotify.com, www.youtube.com (youtube-nocookie
#     is not used anywhere in content, so it is left out)
#   - form: https://formspree.io (the live contact form action)
#   - analytics: static.cloudflareinsights.com (proposed in PLAN.md §3; harmless
#     to allow now, unused until the user opts in)
#
# script-src: astro.config sets vite.build.assetsInlineLimit 0, so Astro
# bundles every component script to /_astro/*.js ('self' covers them). The
# only inline script left is Base.astro's head script (html.js + the
# motion failsafe + the pagereveal scanline hook), allow-listed by its exact
# SHA-256 instead of 'unsafe-inline'. If it changes, run
# `npm run build && npm run check:csp` (add --write via
# `python3 redesign/scripts/check_csp_hashes.py --write`, then rebuild).

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com 'sha256-WH7erBD13ZTeMS7SHUs0YmCnI3ZfM5be9ZbSHkyUkR0='; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://assets.willvernon.online; media-src 'self' https://assets.willvernon.online; font-src 'self'; connect-src 'self' https://formspree.io https://cloudflareinsights.com https://static.cloudflareinsights.com https://assets.willvernon.online; frame-src https://w.soundcloud.com https://open.spotify.com https://www.youtube.com; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests;
  Strict-Transport-Security: max-age=31536000
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Cache-Control: public, max-age=0, must-revalidate

# '! Cache-Control' detaches the value inherited from /* (Cloudflare merges
# every matching rule and would otherwise comma-join the two values).
/_astro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/styleguide*
  X-Robots-Tag: noindex
