---
import Base from '../layouts/Base.astro';
import { site } from '../content';

const title = site.pages.projects.legacyTitle!;
---

<Base title={title} path="/projects">
  <section class="page-stub container">
    <h1 class="t-h1" data-split="lines">Project Archive</h1>
    <p class="t-label">Page body lands in Phase 4.</p>
  </section>
</Base>

<style>
  .page-stub {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding-block: var(--sp-9);
    min-height: 60svh;
  }
</style>
