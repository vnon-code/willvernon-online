---
// About & Credentials — CH-07.
//
// Every string rendered below is read out of src/content/about.json via the
// `_src` INVENTORY id it carries (see redesign/content/INVENTORY.md,
// "## about.html"), never hand-typed. `bySrc()` is the lookup: it keys on
// the same structural id build_content.py stamped on each item, so nothing
// here can silently drift from the extraction.
//
// Direction D (Phase 2b, Ruled Ground): the body is a bleibtgleich-style
// split — B1 a sticky label column holding each section's H2 (Design
// Personality / Design Skills / Generative Design / Education / Experience),
// B2-B4 the content, each section opening with a `Rule data-rule-cross`
// (D-brutalist-grid.md §5.3). Content wiring, heading order and the
// education/experience accordion a11y are unchanged from Phase 3.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Rule from '../components/grid/Rule.astro';
import Cross from '../components/grid/Cross.astro';
import { about, site, type TextBlock, type Src } from '../content';
import { SOCIAL_LINKS } from '../data/site';

const title = site.pages.about.legacyTitle!;

function bySrc<T extends Src>(items: T[], id: string): T {
  const hit = items.find((item) => item._src?.includes(id));
  if (!hit) throw new Error(`about.astro: src/content/about.json has no item with _src "${id}"`);
  return hit;
}

// ---------- Hero ----------
const h1 = bySrc(about.headings, 'about.h.021');
const profileLabel = bySrc(about.blocks, 'about.copy.040');
const introText = bySrc(about.blocks, 'about.copy.042');

// ---------- Design Personality + Contact ----------
const personalityHeading = bySrc(about.headings, 'about.h.022');
const personalityP1 = bySrc(about.blocks, 'about.copy.044');
const personalityP2 = bySrc(about.blocks, 'about.copy.045');

const contactHeading = bySrc(about.headings, 'about.h.023');
const contactEmail = bySrc(about.blocks, 'about.copy.047');
const cvLink = bySrc(about.links, 'about.link.090');
const contactSocials = SOCIAL_LINKS.filter((s) => s.icon === 'instagram' || s.icon === 'linkedin');

// ---------- Design Skills, grouped by discipline ----------
const skillsHeading = bySrc(about.headings, 'about.h.024');
const skillIds = [
  'about.copy.050',
  'about.copy.051',
  'about.copy.052',
  'about.copy.053',
  'about.copy.054',
  'about.copy.055',
  'about.copy.056',
];
const skillBlocks: TextBlock[] = skillIds.map((id) => bySrc(about.blocks, id));

/** The discipline slug lives in the legacy CSS class already carried on
 * `tag` (e.g. "span.hud-skill-tag.skill-adobe") — read out, never invented. */
function disciplineOf(tag: string): string {
  const m = tag.match(/skill-([a-z0-9]+)/i);
  return m ? m[1].toLowerCase() : 'other';
}

interface SkillGroup {
  discipline: string;
  index: number;
  chips: TextBlock[];
}

const skillGroups: SkillGroup[] = [];
for (const block of skillBlocks) {
  const discipline = disciplineOf(block.tag);
  const current = skillGroups[skillGroups.length - 1];
  if (current && current.discipline === discipline) current.chips.push(block);
  else skillGroups.push({ discipline, index: skillGroups.length, chips: [block] });
}

// ---------- Generative Design (AI toolset) ----------
const generativeHeading = bySrc(about.headings, 'about.h.025');
const commercialLabel = bySrc(about.blocks, 'about.copy.058');
const commercialTools = bySrc(about.blocks, 'about.copy.059');
const openSourceLabel = bySrc(about.blocks, 'about.copy.060');
const openSourceTools = bySrc(about.blocks, 'about.copy.061');
const promptSkills = bySrc(about.blocks, 'about.copy.062');

// ---------- Education (with the credentials accordion) ----------
const educationHeading = bySrc(about.headings, 'about.h.026');

const baHeading = bySrc(about.headings, 'about.h.027');
const baMeta = bySrc(about.blocks, 'about.copy.065');
const linkedProjectsLabel = bySrc(about.blocks, 'about.copy.066');
const projectLinks = ['about.link.091', 'about.link.092', 'about.link.093'].map((id) =>
  bySrc(about.links, id),
);

const certHeHeading = bySrc(about.headings, 'about.h.028');
const certHeMeta = bySrc(about.blocks, 'about.copy.071');

// ---------- Experience ----------
const experienceHeading = bySrc(about.headings, 'about.h.029');
const climbingHeading = bySrc(about.headings, 'about.h.030');
const climbingMeta = bySrc(about.blocks, 'about.copy.074');
const waiterHeading = bySrc(about.headings, 'about.h.031');
const waiterMeta = bySrc(about.blocks, 'about.copy.076');
---

<Base title={title} path="/about">
  <section class="about-hero container">
    <p class="about-kicker t-label">{profileLabel.text}</p>
    <h1 class="t-h1" data-split="lines">{h1.text}</h1>
    <p class="about-intro t-body">{introText.text}</p>
  </section>

  <section class="about-section">
    <Rule origin="start" cross />
    <div class="container about-section-inner">
      <h2 class="t-h3 about-label">{personalityHeading.text}</h2>
      <div class="about-content">
        <p class="t-body">{personalityP1.text}</p>
        <p class="t-body">{personalityP2.text}</p>

        <div class="about-contact">
          <h3 class="t-h3">{contactHeading.text}</h3>
          <p class="t-body about-contact-email">{contactEmail.text}</p>
          <div class="about-contact-row">
            <a href={cvLink.href} class="btn-line">
              {cvLink.text}
            </a>
            <ul class="about-contact-socials" aria-label="Social links">
              {
                contactSocials.map((s) => (
                  <li>
                    <a href={s.href} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                      <Icon name={s.icon} size={18} />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section">
    <Rule origin="start" cross />
    <div class="container about-section-inner">
      <h2 class="t-h3 about-label">{skillsHeading.text}</h2>
      <div class="about-content">
        <ul class="skill-groups">
          {
            skillGroups.map((group) => (
              <li class="skill-group">
                {group.chips.map((chip) => (
                  <span class="t-label skill-chip">{chip.text}</span>
                ))}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="about-section">
    <Rule origin="start" cross />
    <div class="container about-section-inner">
      <h2 class="t-h3 about-label">{generativeHeading.text}</h2>
      <div class="about-content">
        <div class="about-tool-cat">
          <p class="t-label about-tool-cat-label">{commercialLabel.text}</p>
          <p class="t-body">{commercialTools.text}</p>
        </div>
        <div class="about-tool-cat">
          <p class="t-label about-tool-cat-label">{openSourceLabel.text}</p>
          <p class="t-body">{openSourceTools.text}</p>
          <p class="t-body">{promptSkills.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="about-section">
    <Rule origin="start" cross />
    <div class="container about-section-inner">
      <h2 class="t-h3 about-label">{educationHeading.text}</h2>
      <div class="about-content">
        <ul class="cred-list">
          <li class="cred-row">
            <details class="cred-accordion">
              <summary class="cred-summary">
                <span class="cred-summary-head">
                  <h3 class="t-h3">{baHeading.text}</h3>
                  <p class="t-small cred-meta">{baMeta.text}</p>
                </span>
                <Cross class="cred-cross" />
              </summary>
              <div class="cred-content">
                <p class="t-label">{linkedProjectsLabel.text}</p>
                <ul class="cred-project-list">
                  {
                    projectLinks.map((link) => (
                      <li>
                        <a href={link.href} class="cred-project-link">
                          <span>{link.text}</span>
                          <Icon name="arrow" size={14} />
                        </a>
                      </li>
                    ))
                  }
                </ul>
              </div>
            </details>
          </li>

          <li class="cred-row cred-row-plain">
            <h3 class="t-h3">{certHeHeading.text}</h3>
            <p class="t-small cred-meta">{certHeMeta.text}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="about-section">
    <Rule origin="start" cross />
    <div class="container about-section-inner">
      <h2 class="t-h3 about-label">{experienceHeading.text}</h2>
      <div class="about-content">
        <ul class="cred-list">
          <li class="cred-row cred-row-plain">
            <h3 class="t-h3">{climbingHeading.text}</h3>
            <p class="t-small cred-meta">{climbingMeta.text}</p>
          </li>
          <li class="cred-row cred-row-plain">
            <h3 class="t-h3">{waiterHeading.text}</h3>
            <p class="t-small cred-meta">{waiterMeta.text}</p>
          </li>
        </ul>
      </div>
    </div>
  </section>
</Base>

<style>
  .about-hero {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-block: var(--sp-9) var(--sp-7);
  }

  .about-kicker {
    color: var(--ink-2);
  }

  .about-intro {
    max-width: 62ch;
    color: var(--ink-2);
  }

  .about-section {
    position: relative;
    padding-block: var(--sp-8);
  }

  .about-section-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .about-label {
    color: var(--ink);
    font-variation-settings: 'wdth' 100, 'wght' 640;
  }

  .about-content {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    min-width: 0;
  }

  .about-content > .t-body + .t-body {
    margin-top: calc(var(--sp-4) * -1);
  }

  @media (min-width: 1024px) {
    .about-section-inner {
      display: grid;
      grid-template-columns: repeat(var(--bays), 1fr);
      column-gap: var(--g);
      align-items: start;
    }

    .about-label {
      grid-column: 1 / span 1;
      position: sticky;
      top: 96px;
    }

    .about-content {
      grid-column: 2 / span 3;
    }
  }

  /* ---------- Contact (reuses the footer link language) ---------- */
  .about-contact {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--line);
  }

  .about-contact-email {
    color: var(--ink-2);
  }

  .about-contact-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }

  .about-contact-socials {
    display: flex;
    gap: var(--sp-3);
  }

  .about-contact-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink-2);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .about-contact-socials a:hover,
  .about-contact-socials a:focus-visible {
    color: var(--ink);
  }

  /* ---------- Design Skills: a ruled list, grouped by discipline ---------- */
  .skill-groups {
    display: flex;
    flex-direction: column;
  }

  .skill-group {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    padding-block: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .skill-groups li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .skill-chip {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--line);
    padding: var(--sp-2) var(--sp-3);
    color: var(--ink-2);
  }

  /* ---------- Generative Design ---------- */
  .about-tool-cat {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .about-tool-cat-label {
    color: var(--ink-2);
  }

  /* ---------- Education / Experience: ruled rows ---------- */
  .cred-list {
    display: flex;
    flex-direction: column;
  }

  .cred-row {
    border-top: 1px solid var(--line);
  }

  .cred-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .cred-row-plain {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding-block: var(--sp-5);
  }

  .cred-meta {
    color: var(--ink-2);
  }

  .cred-accordion {
    padding-block: var(--sp-1);
  }

  .cred-summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-4);
    list-style: none;
    cursor: pointer;
    min-height: 44px;
    padding-block: var(--sp-4);
  }

  .cred-summary::-webkit-details-marker {
    display: none;
  }

  .cred-summary:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: 3px;
  }

  .cred-summary-head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    flex: 1;
    min-width: 0;
  }

  .cred-cross {
    flex-shrink: 0;
    margin-top: 0.35em;
    transition: transform var(--dur-hover) var(--ease-cut);
  }

  .cred-accordion[open] .cred-cross {
    transform: rotate(45deg);
  }

  .cred-content {
    padding-block-start: var(--sp-1);
    padding-block-end: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .cred-project-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .cred-project-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    min-height: 44px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .cred-project-link:hover,
  .cred-project-link:focus-visible {
    color: var(--ink);
  }
</style>
