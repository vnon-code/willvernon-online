---
// Phase 2b (Direction D, Ruled Ground): the typographic hero plus the full
// home body — Featured Work index, "AI as a Creative Partner." toolset,
// the Silver Linings stems console, and Contact. Every section's copy comes
// from src/content/*.json via src/content (never hand-typed here). Content
// wiring, a11y structure and behaviour are unchanged from Phase 3; only the
// markup/CSS presentation moves onto the bay grid and the new tokens.
import Base from '../layouts/Base.astro';
import { site, home } from '../content';
import Rule from '../components/grid/Rule.astro';
import Cross from '../components/grid/Cross.astro';
import FeaturedWorkIndex from '../components/home/FeaturedWorkIndex.astro';
import AiPartner from '../components/home/AiPartner.astro';
import StemsConsole from '../components/home/StemsConsole.astro';
import ContactChannel from '../components/home/ContactChannel.astro';

const title = site.pages.index.legacyTitle!;

// Hero copy comes from src/content/home.json (never hand-typed).
const block = (tag: string, nth = 0) => home.blocks.filter((b) => b.tag === tag)[nth].text;
const heroName = home.headings.find((h) => h.level === 1)!.text;
const heroWords = heroName.split(' ');
// headings[] holds the rendered H2 (with the '&'). Direction D drops the
// data-glyph ampersand workaround: the H2 renders the full text verbatim,
// and redesign/scripts/check_dom_parity.py's EQUIV map treats
// index.copy.044 as equivalent to index.h.022 instead.
const heroTagline = home.headings.filter((h) => h.level === 2)[0].text;
const heroReadout = block('p.hero-subtitle');
const heroDesc = block('p.hero-desc');
const ctaPrimary = block('a.btn-primary');
const ctaAi = block('a.btn-secondary', 0);
const ctaExperiments = block('a.btn-secondary', 1);
// first plain <span> block is the hero 'Scroll' tick label (index.copy.049)
const scrollLabel = block('span');
---

<Base title={title} path="/">
  <section class="hero container" data-hero>
    <p class="hero-label t-label">{heroReadout}</p>

    <div class="hero-name-box">
      <Cross pop class="hero-name-cross hero-name-cross--tl" />
      <h1 class="hero-name" data-kinetic="wdth">
        {heroWords.map((w) => <span class="hero-name-line">{w}</span>)}
      </h1>
      <Cross pop class="hero-name-cross hero-name-cross--br" />
    </div>

    <Rule origin="center" class="hero-rule" />

    <div class="hero-split">
      <h2 class="hero-tagline t-h2" data-split="lines">{heroTagline}</h2>
      <p class="hero-desc t-body">{heroDesc}</p>
    </div>

    <div class="hero-actions">
      <div class="hero-ctas">
        <a href="/projects" class="btn is-full-mobile">{ctaPrimary}</a>
        <div class="hero-ctas-links">
          <a href="/AI" class="link">{ctaAi}</a>
          <a href="/experiments" class="link">{ctaExperiments}</a>
        </div>
      </div>

      <div class="hero-scroll" data-hero-scroll>
        <span class="t-label">{scrollLabel}</span>
        <span class="hero-scroll-tick" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <FeaturedWorkIndex />
  <AiPartner />
  <StemsConsole />
  <ContactChannel />
</Base>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding-block: var(--sp-9) var(--sp-8);
    min-height: 100svh;
    justify-content: center;
  }

  .hero-label {
    color: var(--ink-2);
  }

  /* No paint containment here: the corner crosses sit half outside the
   * box. kinetic.ts contains the H1 itself. */
  .hero-name-box {
    position: relative;
  }

  .hero-name {
    display: flex;
    flex-direction: column;
    font-family: var(--font);
    font-size: var(--fs-mega);
    line-height: var(--lh-mega);
    letter-spacing: var(--ls-mega);
    font-weight: 820;
    /* --wdth is set explicitly (never via a var() fallback): kinetic.ts
     * registers it with an initialValue, which would win over a fallback. */
    --wdth: 125;
    font-variation-settings: 'wdth' var(--wdth), 'wght' 820;
    color: var(--ink);
  }

  .hero-name-line {
    display: block;
  }

  /* Corner registration marks. Scoped through the box (the class lands on
   * the Cross component's root, whose own `.cross` rule would otherwise win
   * the cascade) and offset with margins, not a transform, so the pop-in's
   * scale/rotate never fights the corner offset. */
  .hero-name-box :global(.hero-name-cross) {
    position: absolute;
    z-index: 1;
  }

  .hero-name-box :global(.hero-name-cross--tl) {
    top: 0;
    left: 0;
    margin: -5.5px 0 0 -5.5px;
  }

  .hero-name-box :global(.hero-name-cross--br) {
    bottom: 0;
    right: 0;
    margin: 0 -5.5px -5.5px 0;
  }

  @media (max-width: 767px) {
    .hero-name {
      --wdth: 108;
    }
  }

  .hero-rule {
    margin-block: var(--sp-2);
  }

  .hero-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-4);
  }

  .hero-tagline {
    color: var(--ink);
    max-width: 40ch;
  }

  .hero-desc {
    color: var(--ink-2);
    max-width: 40ch;
  }

  @media (min-width: 1024px) {
    .hero-split {
      grid-template-columns: repeat(var(--bays), 1fr);
      column-gap: var(--g);
      align-items: start;
    }

    .hero-desc {
      grid-column: 1 / span 2;
      grid-row: 1;
      order: -1;
    }

    .hero-tagline {
      grid-column: 3 / span 2;
      grid-row: 1;
    }
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .hero-ctas {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--sp-4);
  }

  .hero-ctas-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
  }

  .is-full-mobile {
    width: 100%;
  }

  .hero-scroll {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-actions {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--sp-6);
    }

    .hero-ctas {
      flex-direction: row;
      align-items: center;
    }

    .is-full-mobile {
      width: auto;
    }

    .hero-scroll {
      display: flex;
      align-items: flex-end;
      gap: var(--sp-2);
      color: var(--ink-2);
    }
  }

  .hero-scroll-tick {
    display: block;
    width: 1px;
    height: 64px;
    background: var(--ink);
    animation: hero-scroll-tick 1.6s var(--ease-move) infinite;
  }

  @keyframes hero-scroll-tick {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45%,
    55% {
      transform: scaleY(1);
      transform-origin: top;
    }
    50% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  [data-hero-scroll].is-scrolled {
    visibility: hidden;
  }
</style>

<script>
  import { initHeroScroll } from '../scripts/home/hero-scroll';
  initHeroScroll();
</script>
