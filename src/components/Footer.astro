---
// Legacy v1 shipped no <footer> element at all (grepped: no footer content in
// legacy/*.html beyond the nav-header social icons and the contact section,
// which each page keeps in its own body — see redesign/content/*.json,
// footer/footer_text are empty on every page). This is new shell chrome: the
// contact email + back-to-top, plus the full social set already used in the
// nav-header (index.nav.013-016) and the contact section (Instagram/
// LinkedIn/SoundCloud/Bandcamp), so every social link stays reachable from
// every page. Direction D (Phase 2b) makes the footer one of the two "studio"
// (inverted, ink-ground) surfaces — see D-brutalist-grid.md §5.1.
import { CONTACT_EMAIL, SOCIAL_LINKS } from '../data/site';
import Icon from './Icon.astro';
import GridFrame from './grid/GridFrame.astro';
import Rule from './grid/Rule.astro';
---

<footer class="footer" data-surface="ink">
  <GridFrame local />
  <Rule origin="start" cross />
  <div class="container footer-inner">
    <a href={`mailto:${CONTACT_EMAIL}`} class="footer-email t-h2">{CONTACT_EMAIL}</a>

    <div class="footer-aside">
      <ul class="footer-socials" aria-label="Social links">
        {
          SOCIAL_LINKS.map((social) => (
            <li>
              <a
                href={social.href}
                target={social.href.startsWith('http') ? '_blank' : undefined}
                rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                aria-label={social.label}
              >
                <Icon name={social.icon} size={18} />
              </a>
            </li>
          ))
        }
      </ul>
      <button type="button" class="btn-line footer-top" id="back-to-top">
        Back to top
        <Icon name="arrow" size={16} class="icon-arrow footer-top-icon" />
      </button>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding-block: var(--sp-8);
    margin-top: var(--sp-10);
  }

  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-7);
    padding-block: var(--sp-6);
  }

  .footer-email {
    color: var(--on-ink);
    width: fit-content;
  }

  .footer-aside {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }

  .footer-socials {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  .footer-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--on-ink-2);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .footer-socials a:hover,
  .footer-socials a:focus-visible {
    color: var(--on-ink);
  }

  .footer-top {
    color: var(--on-ink);
    border-color: var(--on-ink);
  }

  .footer-top-icon {
    transform: rotate(-90deg);
  }

  .footer-top:hover .footer-top-icon,
  .footer-top:focus-visible .footer-top-icon {
    transform: rotate(-90deg) translateX(4px);
  }

  @media (min-width: 1024px) {
    .footer-inner {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>

<script>
  const backToTop = document.getElementById('back-to-top');
  backToTop?.addEventListener('click', () => {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
  });
</script>
