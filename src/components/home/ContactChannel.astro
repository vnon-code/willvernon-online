---
/**
 * Home section 4, Contact — HUD contact card (email, social links, "Copied!" scramble
 * on the Discord handle) beside the Formspree message form. The form is
 * plain progressive enhancement: action/method are real attributes so a
 * POST works with JS disabled exactly as it did in legacy (Formspree's own
 * response page); src/scripts/home/contact.ts only intercepts to show an
 * inline status instead of leaving the page, and to wire the Discord
 * copy-to-clipboard button. Every field/label/placeholder comes from
 * home.contactForm (never hand-typed) — the "e.g. Adnan"-style placeholders
 * included.
 */
import { home, site } from '../../content';
import ChannelLabel from '../ChannelLabel.astro';
import { homeChannel } from '../../data/site';
import Icon from '../Icon.astro';

const heading = home.headings.find((h) => h.level === 2 && h.text === 'Contact')!.text;
const intro = home.blocks.find((b) => b.tag === 'p.text-gray-400.font-mono')!.text;
const labels = home.blocks.filter((b) => b.tag === 'p.contact-item-label').map((b) => b.text);
const [emailLabel, linksLabel, socialLabel, musicLabel] = labels;
const emailVal = home.blocks.find((b) => b.tag === 'a.contact-item-val')!.text;
const copiedText = home.blocks.find((b) => b.tag === 'span.font-mono')!.text;
const formHeading = home.blocks.find((b) => b.tag === 'h3.uppercase.text-xl')!.text;

const social = (platform: string) => site.socials.find((s) => s.platform === platform)!;
const instagram = social('instagram');
const linkedin = social('linkedin');
const tiktok = social('tiktok');
const discord = social('discord');
// Legacy aria-label was the platform name ('Discord').
const discordName = discord.platform.charAt(0).toUpperCase() + discord.platform.slice(1);
const soundcloud = social('soundcloud');
const bandcamp = social('bandcamp');

const emailHref = social('email').href;
const form = home.contactForm;
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <div class="container contact-inner">
    <div class="contact-head" data-reveal="fade">
      <ChannelLabel channel={homeChannel(4)} />
      <h2 id="contact-heading" class="t-h2">{heading}</h2>
      <p class="t-body contact-intro">{intro}</p>
    </div>

    <div class="contact-grid">
      <div class="contact-details" data-reveal="fade">
        <div class="contact-item">
          <p class="t-mono contact-item-label">{emailLabel}</p>
          <a href={emailHref} class="contact-item-val t-h3">{emailVal}</a>
        </div>

        <div class="contact-item">
          <p class="t-mono contact-item-label">{linksLabel}</p>

          <div class="contact-link-group">
            <p class="t-mono contact-sub-label">{socialLabel}</p>
            <ul class="contact-icon-row">
              <li>
                <a href={instagram.href} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                  <Icon name="instagram" size={20} />
                </a>
              </li>
              <li>
                <a href={linkedin.href} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                  <Icon name="linkedin" size={20} />
                </a>
              </li>
              <li>
                <a href={tiktok.href} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                  <Icon name="tiktok" size={20} />
                </a>
              </li>
              <li class="contact-discord">
                <a href={discord.href} class="contact-discord-btn" aria-label={discordName} data-discord-copy data-discord-handle={discord.handle}>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M8.5 15.5c2.2 1.3 4.8 1.3 7 0M9.5 9.8c-.3-.2-.7-.2-1 0-.9.6-1.5 1.6-1.8 2.8-.5 2.2.4 4.5 2 5.9.2.2.6.2.9 0 .5-.4.9-.8 1.3-1.3m3.2 0c.4.5.8.9 1.3 1.3.3.2.7.2.9 0 1.6-1.4 2.5-3.7 2-5.9-.3-1.2-.9-2.2-1.8-2.8-.3-.2-.7-.2-1 0M9 13.2c0 .7.5 1.3 1 1.3s1-.6 1-1.3-.5-1.3-1-1.3-1 .6-1 1.3Zm4 0c0 .7.5 1.3 1 1.3s1-.6 1-1.3-.5-1.3-1-1.3-1 .6-1 1.3Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </a>
                <span class="t-mono contact-discord-tooltip" data-discord-tooltip data-copied={copiedText} role="status"></span>
              </li>
            </ul>
          </div>

          <div class="contact-link-group">
            <p class="t-mono contact-sub-label">{musicLabel}</p>
            <ul class="contact-icon-row">
              <li>
                <a href={soundcloud.href} target="_blank" rel="noopener noreferrer" aria-label="SoundCloud">
                  <Icon name="soundcloud" size={20} />
                </a>
              </li>
              <li>
                <a href={bandcamp.href} target="_blank" rel="noopener noreferrer" aria-label="Bandcamp">
                  <Icon name="bandcamp" size={20} />
                </a>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <div class="contact-form-panel" data-reveal="fade">
        <h3 class="t-h3 contact-form-heading">{formHeading}</h3>

        <form id="contact-form" class="contact-form" action={form.action ?? undefined} method={form.method}>
          {
            form.fields.map((field) => (
              <div class="form-group">
                <label class="t-mono form-label" for={`form-${field.name}`}>
                  {field.label}
                </label>
                {field.type === 'textarea' ? (
                  <textarea
                    id={`form-${field.name}`}
                    name={field.name ?? undefined}
                    class="form-input form-textarea"
                    placeholder={field.placeholder ?? undefined}
                    required={field.required}
                    rows={5}
                  />
                ) : (
                  <input
                    type={field.type as 'text' | 'email'}
                    id={`form-${field.name}`}
                    name={field.name ?? undefined}
                    class="form-input"
                    placeholder={field.placeholder ?? undefined}
                    required={field.required}
                  />
                )}
              </div>
            ))
          }

          <button type="submit" class="btn btn-primary contact-submit">{form.submitLabel}</button>

          <p class="t-small contact-form-status" data-form-status role="status" aria-live="polite" hidden></p>
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-section {
    border-top: 1px solid var(--line);
    padding-block: var(--sp-9);
  }

  .contact-head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: 60ch;
    margin-bottom: var(--sp-7);
  }

  .contact-intro {
    color: var(--text-muted);
  }

  .contact-grid {
    display: grid;
    gap: var(--sp-7);
  }

  .contact-details {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .contact-item-label {
    color: var(--accent);
  }

  .contact-item-val {
    color: var(--text);
    width: fit-content;
    transition: color var(--dur-fast) var(--ease-out);
  }

  .contact-item-val:hover,
  .contact-item-val:focus-visible {
    color: var(--accent);
  }

  .contact-link-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: var(--sp-2);
  }

  .contact-sub-label {
    color: var(--text-muted);
  }

  .contact-icon-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .contact-icon-row a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    color: var(--text-muted);
    border: 1px solid var(--line);
    border-radius: 2px;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }

  .contact-icon-row a:hover,
  .contact-icon-row a:focus-visible {
    color: var(--accent);
    border-color: var(--accent);
  }

  .contact-discord {
    position: relative;
  }

  .contact-discord-tooltip {
    position: absolute;
    bottom: calc(100% + var(--sp-2));
    left: 50%;
    transform: translateX(-50%);
    background: var(--surface-2);
    border: 1px solid var(--line);
    color: var(--accent);
    padding: var(--sp-1) var(--sp-2);
    border-radius: 2px;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-fast) var(--ease-out);
  }

  .contact-discord-tooltip[data-visible] {
    opacity: 1;
  }

  .contact-form-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .contact-form-heading {
    color: var(--text);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .form-label {
    color: var(--text-muted);
  }

  .form-input {
    min-height: 44px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 2px;
    padding-inline: var(--sp-3);
    padding-block: var(--sp-2);
    color: var(--text);
    font-family: var(--font-body);
    font-size: var(--fs-body);
    transition: border-color var(--dur-fast) var(--ease-out);
  }

  .form-input::placeholder {
    color: var(--text-muted);
  }

  .form-input:focus-visible {
    border-color: var(--accent);
  }

  .form-textarea {
    min-height: 120px;
    resize: vertical;
  }

  .contact-submit {
    justify-content: center;
    width: 100%;
    margin-top: var(--sp-2);
  }

  .contact-form-status {
    color: var(--text-muted);
  }

  .contact-form-status[data-tone='ok'] {
    color: var(--text);
  }

  .contact-form-status[data-tone='error'] {
    color: var(--accent);
  }

  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    }
  }
</style>

<script>
  import { initContactForm } from '../../scripts/home/contact';
  initContactForm();
</script>
