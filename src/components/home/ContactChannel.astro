---
/**
 * Home section 4, Contact — the email as a large link (copy-to-clipboard
 * Discord handle beside it), the socials as a ruled list, and the Formspree
 * message form inside a `Frame`. Direction D (Phase 2b): B1-B4 the email at
 * --fs-h1 (breaks at '@' below 768 via <wbr>), B1-B2 the socials, B3-B4 the
 * form (D-brutalist-grid.md §5.2). The form is plain progressive
 * enhancement: action/method are real attributes so a POST works with JS
 * disabled exactly as it did in legacy (Formspree's own response page);
 * src/scripts/home/contact.ts only intercepts to show an inline status
 * instead of leaving the page, and wires the Discord copy-to-clipboard
 * button with a static "Copied" label swap (no scramble). Every field/
 * label/placeholder comes from home.contactForm (never hand-typed).
 */
import { home, site } from '../../content';
import Icon from '../Icon.astro';
import Rule from '../grid/Rule.astro';
import Frame from '../grid/Frame.astro';

const heading = home.headings.find((h) => h.level === 2 && h.text === 'Contact')!.text;
const intro = home.blocks.find((b) => b.tag === 'p.text-gray-400.font-mono')!.text;
const labels = home.blocks.filter((b) => b.tag === 'p.contact-item-label').map((b) => b.text);
const [emailLabel, linksLabel, socialLabel, musicLabel] = labels;
const emailVal = home.blocks.find((b) => b.tag === 'a.contact-item-val')!.text;
const copiedText = home.blocks.find((b) => b.tag === 'span.font-mono')!.text;
const formHeading = home.blocks.find((b) => b.tag === 'h3.uppercase.text-xl')!.text;

const social = (platform: string) => site.socials.find((s) => s.platform === platform)!;
const instagram = social('instagram');
const linkedin = social('linkedin');
const tiktok = social('tiktok');
const discord = social('discord');
// Legacy aria-label was the platform name ('Discord').
const discordName = discord.platform.charAt(0).toUpperCase() + discord.platform.slice(1);
const soundcloud = social('soundcloud');
const bandcamp = social('bandcamp');

const emailHref = social('email').href;
const [emailUser, emailDomain] = emailVal.split('@');
const form = home.contactForm;
---

<section id="contact" class="contact-section" aria-labelledby="contact-heading">
  <Rule origin="start" />
  <div class="container contact-inner">
    <div class="contact-head">
      <h2 id="contact-heading" class="t-h2" data-split="lines">{heading}</h2>
      <p class="t-body contact-intro">{intro}</p>
    </div>

    <Rule origin="end" cross class="contact-email-rule" />

    <a href={emailHref} class="contact-email t-h1" data-hot>
      {emailUser}@<wbr />{emailDomain}
    </a>

    <div class="contact-grid">
      <div class="contact-links">
        <p class="t-label contact-links-label">{linksLabel}</p>

        <ul class="contact-ruled-list">
          <li>
            <p class="t-label contact-sub-label">{socialLabel}</p>
            <div class="contact-icon-row">
              <a href={instagram.href} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                <Icon name="instagram" size={20} />
              </a>
              <a href={linkedin.href} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                <Icon name="linkedin" size={20} />
              </a>
              <a href={tiktok.href} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                <Icon name="tiktok" size={20} />
              </a>
              <span class="contact-discord">
                <button type="button" class="contact-discord-btn" aria-label={discordName} data-discord-copy data-discord-handle={discord.handle}>
                  <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true" focusable="false">
                    <path d="M8.5 15.5c2.2 1.3 4.8 1.3 7 0M9.5 9.8c-.3-.2-.7-.2-1 0-.9.6-1.5 1.6-1.8 2.8-.5 2.2.4 4.5 2 5.9.2.2.6.2.9 0 .5-.4.9-.8 1.3-1.3m3.2 0c.4.5.8.9 1.3 1.3.3.2.7.2.9 0 1.6-1.4 2.5-3.7 2-5.9-.3-1.2-.9-2.2-1.8-2.8-.3-.2-.7-.2-1 0M9 13.2c0 .7.5 1.3 1 1.3s1-.6 1-1.3-.5-1.3-1-1.3-1 .6-1 1.3Zm4 0c0 .7.5 1.3 1 1.3s1-.6 1-1.3-.5-1.3-1-1.3-1 .6-1 1.3Z" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </button>
                <span class="t-label contact-discord-tooltip" data-discord-tooltip data-copied={copiedText} role="status"></span>
              </span>
            </div>
          </li>

          <li>
            <p class="t-label contact-sub-label">{musicLabel}</p>
            <div class="contact-icon-row">
              <a href={soundcloud.href} target="_blank" rel="noopener noreferrer" aria-label="SoundCloud">
                <Icon name="soundcloud" size={20} />
              </a>
              <a href={bandcamp.href} target="_blank" rel="noopener noreferrer" aria-label="Bandcamp">
                <Icon name="bandcamp" size={20} />
              </a>
            </div>
          </li>
        </ul>

        <p class="t-label contact-links-label contact-email-label">{emailLabel}</p>
      </div>

      <Frame as="div" class="contact-form-panel">
        <h3 class="t-h3 contact-form-heading">{formHeading}</h3>

        <form id="contact-form" class="contact-form" action={form.action ?? undefined} method={form.method}>
          {
            form.fields.map((field) => (
              <div class="form-group">
                <label class="form-label" for={`form-${field.name}`}>
                  {field.label}
                </label>
                {field.type === 'textarea' ? (
                  <textarea
                    id={`form-${field.name}`}
                    name={field.name ?? undefined}
                    placeholder={field.placeholder ?? undefined}
                    required={field.required}
                    rows={5}
                  />
                ) : (
                  <input
                    type={field.type as 'text' | 'email'}
                    id={`form-${field.name}`}
                    name={field.name ?? undefined}
                    placeholder={field.placeholder ?? undefined}
                    required={field.required}
                  />
                )}
              </div>
            ))
          }

          <button type="submit" class="btn is-full contact-submit">{form.submitLabel}</button>

          <p class="t-small contact-form-status" data-form-status role="status" aria-live="polite" hidden></p>
        </form>
      </Frame>
    </div>
  </div>
</section>

<style>
  .contact-section {
    position: relative;
    padding-block: var(--sp-9) var(--sp-10);
  }

  .contact-head {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: 60ch;
    margin-bottom: var(--sp-7);
  }

  .contact-intro {
    color: var(--ink-2);
  }

  .contact-email {
    display: block;
    color: var(--ink);
    width: fit-content;
    max-width: 100%;
    overflow-wrap: anywhere;
    margin-bottom: var(--sp-8);
  }

  .contact-email::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--state);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-hover) var(--ease-step);
    z-index: -1;
  }

  .contact-email {
    position: relative;
  }

  .contact-email:focus-visible::before {
    transform: scaleX(1);
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-email:hover::before {
      transform: scaleX(1);
    }
  }

  .contact-email-rule {
    margin-block: var(--sp-7) var(--sp-6);
  }

  .contact-grid {
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .contact-links-label {
    color: var(--ink-2);
  }

  .contact-ruled-list {
    display: flex;
    flex-direction: column;
  }

  .contact-ruled-list li {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-block: var(--sp-4);
    border-top: 1px solid var(--line);
  }

  .contact-ruled-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .contact-sub-label {
    color: var(--ink-2);
  }

  .contact-icon-row {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
  }

  .contact-icon-row a,
  .contact-icon-row button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink-2);
    border: 1px solid var(--line);
    transition:
      color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out);
  }

  .contact-icon-row a:hover,
  .contact-icon-row a:focus-visible,
  .contact-icon-row button:hover,
  .contact-icon-row button:focus-visible {
    color: var(--ink);
    border-color: var(--ink);
  }

  .contact-discord {
    position: relative;
    display: inline-flex;
  }

  .contact-discord-tooltip {
    position: absolute;
    bottom: calc(100% + var(--sp-2));
    left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    color: var(--paper);
    padding: var(--sp-1) var(--sp-2);
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-tap) var(--ease-cut);
  }

  .contact-discord-tooltip[data-visible] {
    opacity: 1;
  }

  .contact-form-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    padding: var(--sp-5);
  }

  .contact-form-heading {
    color: var(--ink);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .contact-submit {
    margin-top: var(--sp-2);
  }

  .contact-form-status {
    color: var(--ink-2);
  }

  .contact-form-status[data-tone='ok'] {
    color: var(--ink);
  }

  .contact-form-status[data-tone='error'] {
    color: var(--ink);
    font-weight: 640;
  }

  @media (min-width: 1024px) {
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(var(--bays), 1fr);
      column-gap: var(--g);
      align-items: start;
    }

    .contact-links {
      grid-column: 1 / span 2;
    }

    .contact-form-panel {
      grid-column: 3 / span 2;
    }
  }
</style>

<script>
  import { initContactForm } from '../../scripts/home/contact';
  initContactForm();
</script>
