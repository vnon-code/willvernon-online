---
/**
 * Home section 2, "AI as a Creative Partner" — the intro copy plus the AI toolset
 * directory. Legacy showed the 9 tools as a hover-only marquee driving one
 * shared HUD card (mouse/first-tool-only content); this is an accessible
 * disclosure list instead — native <details>/<summary> per tool, so every
 * title/company/apps string is in the DOM and keyboard/screen-reader
 * reachable without JS, no hover required. `data-tool` is kept on each
 * <details> for INVENTORY parity (AI_TOOLSET_DATA's div[data-tool] ids).
 */
import { home } from '../../content';
import ChannelLabel from '../ChannelLabel.astro';
import { homeChannel } from '../../data/site';

const heading = home.headings.find((h) => h.level === 2 && h.text === 'AI as a Creative Partner.')!.text;
const eyebrow = home.blocks.filter((b) => b.tag === 'p.font-mono.text-accent')[0].text;
const paras = home.blocks.filter((b) => b.tag === 'p.text-lg.text-gray-400');
const [paraOne, paraTwo] = paras;
const cta = home.blocks.filter((b) => b.tag === 'a.btn-primary')[1].text;
const usecasesLabel = home.blocks.find((b) => b.tag === 'span.hud-spec-label')!.text;

const tools = Object.entries(home.toolset);
---

<section id="ai" class="ai-section" aria-labelledby="ai-heading">
  <div class="container ai-inner">
    <div class="ai-copy" data-reveal="fade">
      <ChannelLabel channel={homeChannel(2)} />
      <p class="t-mono ai-eyebrow" data-scramble>{eyebrow}</p>
      <h2 id="ai-heading" class="t-h2">{heading}</h2>
      <p class="t-body">{paraOne.text}</p>
      <p class="t-body">{paraTwo.text}</p>
      <a href="/AI" class="btn btn-primary">{cta}</a>
    </div>

    <ul class="ai-tool-list" aria-label="AI tools" data-reveal-stagger>
      {
        tools.map(([key, tool], i) => (
          <li>
            <details class="ai-tool" data-tool={key} open={i === 0}>
              <summary class="ai-tool-summary">
                <img
                  src={tool.logo ?? ''}
                  alt={tool.title}
                  width="40"
                  height="40"
                  loading="lazy"
                  class="ai-tool-logo"
                />
                <span class="ai-tool-title t-h3">{tool.title}</span>
                <span class="ai-tool-company t-mono">[ {tool.company} ]</span>
              </summary>
              <div class="ai-tool-panel">
                <p class="t-mono ai-tool-usecases">{usecasesLabel}</p>
                <p class="t-small ai-tool-apps">{tool.apps}</p>
              </div>
            </details>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ai-section {
    border-top: 1px solid var(--line);
    padding-block: var(--sp-9);
  }

  .ai-inner {
    display: grid;
    gap: var(--sp-8);
  }

  .ai-copy {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    max-width: 60ch;
  }

  .ai-copy .btn {
    margin-top: var(--sp-2);
    align-self: flex-start;
  }

  .ai-tool-list {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .ai-tool {
    border-bottom: 1px solid var(--line);
  }

  .ai-tool-summary {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding-block: var(--sp-4);
    cursor: pointer;
    list-style: none;
  }

  /* Hide the native marker, draw our own state indicator instead. */
  .ai-tool-summary::-webkit-details-marker {
    display: none;
  }

  .ai-tool-summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .ai-tool-logo {
    flex-shrink: 0;
    border-radius: 2px;
    background: var(--surface);
    object-fit: contain;
  }

  .ai-tool-title {
    color: var(--text);
  }

  .ai-tool-company {
    color: var(--text-muted);
    margin-inline-start: auto;
    white-space: nowrap;
  }

  .ai-tool-summary::after {
    content: '+';
    flex-shrink: 0;
    margin-inline-start: var(--sp-2);
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: var(--fs-h3);
    line-height: 1;
    transition: transform var(--dur-fast) var(--ease-out);
  }

  .ai-tool[open] .ai-tool-summary::after {
    transform: rotate(45deg);
  }

  .ai-tool-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding-block-end: var(--sp-5);
    padding-inline-start: calc(40px + var(--sp-4));
  }

  .ai-tool-usecases {
    color: var(--text-muted);
  }

  .ai-tool-apps {
    color: var(--text-muted);
    max-width: 60ch;
  }

  @media (min-width: 900px) {
    .ai-inner {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }
  }
</style>
