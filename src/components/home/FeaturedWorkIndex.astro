---
/**
 * CH-01 "Featured Work" — a numbered project index, not a card grid. Rows
 * link exactly where the legacy cards linked (home.featuredWork[].href,
 * already routed). Direction D (Phase 2b): the whole row is the link
 * (`data-hot`, D-brutalist-grid.md §5.2/§4.2), separated by dashed rules,
 * laid out on the bay grid (B1 label, B2-B3 title+desc, B4 tags+CTA).
 *
 * Preview video: fine-pointer hover only, after a short intent delay; never
 * on keyboard focus or touch. src is set on intent and removed again on
 * leave so an abandoned hover stops downloading. Under
 * prefers-reduced-motion the script never starts playback at all.
 */
import { home } from '../../content';
import Icon from '../Icon.astro';
import Rule from '../grid/Rule.astro';

const heading = home.headings.find((h) => h.level === 2 && h.text === 'Featured Work')!.text;
const viewCaseStudy = home.blocks.find((b) => b.tag === 'span.neon-card-overlay-btn')!.text;

function fixHref(href: string | null): string {
  if (!href) return '#';
  return href === '/ai' ? '/AI' : href;
}
---

<section id="work" class="fw-section" aria-labelledby="fw-heading">
  <Rule origin="start" cross />
  <div class="container fw-inner">
    <h2 id="fw-heading" class="t-h2 fw-heading" data-split="lines">{heading}</h2>

    <ol class="fw-index" data-reveal-stagger>
      {
        home.featuredWork.map((fw) => (
          <li>
            <a
              href={fixHref(fw.href)}
              class="fw-row"
              data-hot
              data-fw-row
              data-fw-src={fw.media.src ?? undefined}
            >
              <span class:list={['fw-row-preview', fw.media.type === 'video' && 'has-video']} aria-hidden="true">
                {fw.media.type === 'video' && (
                  <video data-fw-video muted loop playsinline preload="none" tabindex="-1" />
                )}
              </span>

              <span class="fw-row-label t-label">{fw.label}</span>

              <span class="fw-row-body">
                <h3 class="fw-row-title t-row">{fw.title}</h3>
                <p class="fw-row-desc t-small">{fw.desc}</p>
              </span>

              <span class="fw-row-meta">
                {fw.tags.length > 0 && (
                  <span class="fw-row-tags t-small">{fw.tags.join(' / ')}</span>
                )}
                <span class="fw-row-cta t-label">
                  {viewCaseStudy}
                  <Icon name="arrow" size={14} class="fw-row-cta-icon" />
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .fw-section {
    position: relative;
    padding-block: var(--sp-9);
  }

  .fw-inner {
    display: flex;
    flex-direction: column;
    gap: var(--sp-7);
  }

  .fw-heading {
    color: var(--ink);
    max-width: 20ch;
  }

  .fw-index {
    display: flex;
    flex-direction: column;
  }

  .fw-index li {
    border-top: 1px dashed var(--line);
  }

  .fw-index li:last-child {
    border-bottom: 1px dashed var(--line);
  }

  .fw-row {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding-block: var(--sp-5);
    color: var(--ink);
  }

  .fw-row-label {
    color: var(--ink-2);
  }

  .fw-row-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    min-width: 0;
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .fw-row-title {
    color: var(--ink);
  }

  .fw-row-desc {
    color: var(--ink-2);
    max-width: 60ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .fw-row-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .fw-row-tags {
    color: var(--ink-2);
  }

  .fw-row-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    color: var(--ink);
    margin-inline-start: auto;
    white-space: nowrap;
  }

  .fw-row-cta-icon {
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .fw-row:focus-visible .fw-row-cta-icon {
    transform: translateX(4px);
  }

  .fw-row:focus-visible .fw-row-body {
    transform: translateX(12px);
  }

  @media (hover: hover) and (pointer: fine) {
    .fw-row:hover .fw-row-cta-icon {
      transform: translateX(4px);
    }

    .fw-row:hover .fw-row-body {
      transform: translateX(12px);
    }
  }

  .fw-row:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -2px;
  }

  /* Stepped state fill: a --state block wipes in behind the row on hover,
   * per D-brutalist-grid.md §4.2 (index rows). */
  .fw-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--state);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-hover) var(--ease-step);
    z-index: -1;
  }

  @media (hover: hover) and (pointer: fine) {
    .fw-row:hover::before,
    .fw-row:focus-visible::before {
      transform: scaleX(1);
    }
  }

  @media (hover: hover) and (pointer: fine) {
    .fw-row:hover .fw-row-desc,
    .fw-row:focus-visible .fw-row-desc {
      -webkit-line-clamp: unset;
    }
  }

  /* ≥1024: the row sits on the bay grid (B1 label, B2-B3 title+desc, B4
   * tags+CTA), and the hover preview is locked to B4: one bay wide, row
   * height x1.6, revealed as a clip-path wipe (§4.2), never following the
   * cursor. Real width/height, so the 1px border is never stretched. */
  .fw-row-preview {
    display: none;
  }

  @media (min-width: 1024px) {
    .fw-row {
      display: grid;
      grid-template-columns: repeat(var(--bays), minmax(0, 1fr));
      column-gap: var(--g);
      align-items: start;
    }

    .fw-row-label {
      grid-column: 1;
    }

    .fw-row-body {
      grid-column: 2 / span 2;
    }

    .fw-row-meta {
      grid-column: 4;
      flex-direction: column;
      align-items: flex-end;
    }

    .fw-row-preview.has-video {
      display: block;
      position: absolute;
      z-index: 2;
      top: -30%;
      right: 0;
      width: calc((100% - 3 * var(--g)) / 4);
      height: 160%;
      overflow: hidden;
      border: 1px solid var(--ink);
      background: var(--paper-2);
      pointer-events: none;
      clip-path: inset(0 0 100% 0);
      transition: clip-path var(--dur-reveal) var(--ease-out);
    }

    .fw-row.is-playing .fw-row-preview {
      clip-path: inset(0 0 0 0);
    }

    .fw-row-preview video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* <1024 / touch: the media shows inline at 16:10 (§5.2). featured-work.ts
   * loads a still (and plays it muted while in view unless reduced motion);
   * without JS there's nothing to show, so the box only exists under
   * html.js. */
  @media (max-width: 1023px) {
    :global(html.js) .fw-row-preview.has-video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: var(--paper-2);
      order: -1;
    }

    .fw-row-preview video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fw-row-preview.has-video {
      transition: none;
    }
  }
</style>

<script>
  import { initFeaturedWork } from '../../scripts/home/featured-work';
  initFeaturedWork();
</script>
