---
/**
 * Home section 3, "Liquid Drum & Bass" — the music intro copy plus the Silver
 * Linings stems console: 5 stems, a master player, per-stem mute + FX
 * sliders (min/max/step/labels straight from STEMS_CONFIG/trackParams/
 * FX_SLIDERS_CONFIG, via home.stems), all with VISIBLE <label> elements
 * bound to their inputs — the legacy critical axe issue (icon-only sliders,
 * no label) this fixes.
 *
 * Direction D (Phase 2b): this is one of the two "studio" (inverted,
 * ink-ground) surfaces (D-brutalist-grid.md §5.2). The mixer channels are
 * vertical strips; the level meter is a single 1px --on-ink line per strip,
 * driven by the analyser via transform only (2D DOM, no canvas — the only
 * audio-reactive visual). All markup is server-rendered up front (every
 * track's FX fieldset exists in the DOM; only the selected one is visible)
 * rather than rebuilding innerHTML on each click. src/scripts/home/
 * stems-console.ts owns the Web Audio graph, track select/mute, live slider
 * values and the level meter; it never runs (no AudioContext) until the
 * play button is pressed. This restyle changes no selector, id or data
 * attribute the script depends on — only layout/CSS moved.
 */
import { home, site } from '../../content';
import { fxDisplay } from '../../scripts/home/fx-format';
import Frame from '../grid/Frame.astro';
import GridFrame from '../grid/GridFrame.astro';

const heading = home.headings.find((h) => h.level === 2 && h.text === 'Liquid Drum & Bass.')!.text;
const eyebrow = home.blocks.filter((b) => b.tag === 'p.font-mono.text-accent')[1].text;
const paras = home.blocks.filter((b) => b.tag === 'p.text-lg.text-gray-400');
const [, , paraOne, paraTwo] = paras;
const ctaExplore = home.blocks.filter((b) => b.tag === 'a.btn-primary')[2].text;
const ctaSoundcloud = home.blocks.filter((b) => b.tag === 'a.btn-secondary')[2].text;
const soundcloudHref = site.socials.find((s) => s.platform === 'soundcloud')!.href;

const spans = home.blocks.filter((b) => b.tag === 'span');
const activeMixerSourceLabel = spans[13].text; // '// ACTIVE_MIXER_SOURCE'
const artistLabel = spans[14].text; // 'CATCHING FLIES'
const activeChannelLabel = spans[20].text; // 'ACTIVE_CHANNEL'
const abbrevs = [spans[15].text, spans[16].text, spans[17].text, spans[18].text, spans[19].text]; // DRM/BAS/MEL/ATM/VOC
const trackLabels = home.blocks.filter((b) => b.tag === 'span.mixer-track-label').map((b) => b.text);
const muteLabel = home.blocks.find((b) => b.tag === 'button.mixer-track-mute-btn')!.text; // 'MUTE'
const fxTitleDefault = home.blocks.find((b) => b.tag === 'span.mixer-fx-title')!.text; // '01. Drums FX'
const trackTitle = home.headings.find((h) => h.level === 3 && h.text.startsWith('SILVER LININGS'))!.text;
const statusText = home.blocks.find((b) => b.tag === 'span' && b.text === 'Master track player')!.text;
const art = home.stems.armedTrackArt!;

const trackKeys = Object.keys(home.stems.stemsConfig);
const stemsConfig = home.stems.stemsConfig;
const trackParams = home.stems.trackParams;
const fxSliders = home.stems.fxSliders;
// Only what the client script needs — never the whole home.json module.
const stemsData = JSON.stringify({ stemsConfig, trackParams });
---

<section id="music" class="music-section" aria-labelledby="music-heading" data-surface="ink">
  <GridFrame local />
  <div class="container music-inner">
    <div class="music-copy">
      <p class="t-label music-eyebrow">{eyebrow}</p>
      <h2 id="music-heading" class="t-h2">{heading}</h2>
      <p class="t-body">{paraOne.text}</p>
      <p class="t-body">{paraTwo.text}</p>
      <div class="music-ctas">
        <a href="/music" class="btn-line music-cta">{ctaExplore}</a>
        <a href={soundcloudHref} target="_blank" rel="noopener noreferrer" class="link">{ctaSoundcloud}</a>
      </div>
    </div>

    <div class="stems-console" data-stems-console data-stems={stemsData}>
      <header class="stems-header">
        <img src={art.src ?? ''} alt={art.alt ?? ''} width="48" height="48" loading="lazy" class="stems-art" />
        <div class="stems-header-text">
          <p class="t-label stems-eyebrow">{activeMixerSourceLabel}</p>
          <h3 class="t-h3 stems-title" data-split="chars">{trackTitle}</h3>
          <p class="t-label stems-artist">{artistLabel}</p>
        </div>
      </header>

      <div class="stems-mixer" data-track-list>
        {
          trackKeys.map((key, i) => (
            <div class="stems-channel">
              <button
                type="button"
                class="stems-track-select"
                data-track-select={key}
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`fx-${key}`}
              >
                <span class="stems-track-dot" aria-hidden="true" />
                <span class="t-label">{trackLabels[i]}</span>
              </button>

              <div class="stems-meter-col" aria-hidden="true">
                <div class="stems-meter-bar" data-meter={key}>
                  <span class="stems-meter-fill" data-meter-fill />
                </div>
                <span class="t-label stems-meter-abbr">{abbrevs[i]}</span>
              </div>

              <button type="button" class="stems-track-mute" id={`mute-${key}`} data-track-mute={key} aria-pressed="false">
                <span class="sr-only">{stemsConfig[key].name} </span>
                <span class="t-label">{muteLabel}</span>
              </button>
            </div>
          ))
        }
      </div>

      <Frame as="div" class="stems-fx">
        <div class="stems-fx-head">
          <span class="t-label" data-fx-title>{fxTitleDefault}</span>
          <span class="t-label stems-fx-active">{activeChannelLabel}</span>
        </div>

        <div id="fx-controls-container">
          {
            trackKeys.map((key, i) => (
              <div class="stems-fx-panel" id={`fx-${key}`} data-fx-panel={key} hidden={i !== 0}>
                {fxSliders[key].map((slider) => {
                  const val = Number(trackParams[key][slider.id]);
                  const inputId = `param-${key}-${slider.id}`;
                  return (
                    <div class="fx-row">
                      <div class="fx-row-head">
                        <label class="t-label" for={inputId}>
                          {slider.label}
                        </label>
                        <output class="t-label fx-row-value" for={inputId} id={`label-${key}-${slider.id}`}>
                          {fxDisplay(slider.id, val)}
                        </output>
                      </div>
                      <input
                        type="range"
                        id={inputId}
                        class="fx-slider"
                        min={slider.min}
                        max={slider.max}
                        step={slider.step}
                        value={val}
                        aria-valuetext={fxDisplay(slider.id, val)}
                        data-track={key}
                        data-param={slider.id}
                      />
                    </div>
                  );
                })}
              </div>
            ))
          }
        </div>
      </Frame>

      <div class="stems-master">
        <div class="stems-master-play">
          <button type="button" id="av-play-btn" class="stems-play-btn btn-line" aria-pressed="false" aria-label="Play mixer loops">
            <svg data-icon-play viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M8 5.5v13l11-6.5z" />
            </svg>
            <svg data-icon-pause style="display: none;" viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M7 5h4v14H7zM13 5h4v14h-4z" />
            </svg>
          </button>
          <span class="t-label stems-status" id="av-status-txt" aria-live="polite">{statusText}</span>
        </div>

        <div class="stems-master-vol">
          <label class="t-label" for="master-vol">Master volume</label>
          <input type="range" id="master-vol" min="0" max="1" step="0.05" value="0.7" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .music-section {
    position: relative;
    padding-block: var(--sp-9);
  }

  .music-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-8);
  }

  .music-copy {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    max-width: 56ch;
  }

  .music-eyebrow {
    color: var(--on-ink-2);
  }

  .music-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-5);
    margin-top: var(--sp-2);
  }

  .music-cta {
    border-color: var(--on-ink);
    color: var(--on-ink);
  }

  .stems-console {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .stems-header {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--line-inv);
  }

  .stems-art {
    border: 1px solid var(--line-inv);
    object-fit: cover;
    flex-shrink: 0;
  }

  .stems-header-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .stems-eyebrow {
    color: var(--on-ink-2);
  }

  .stems-title {
    color: var(--on-ink);
    overflow-wrap: anywhere;
  }

  .stems-artist {
    color: var(--on-ink-2);
  }

  /* ---------- Mixer: 5 vertical channel strips aligned to a shared row ---------- */
  .stems-mixer {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: var(--sp-3);
  }

  .stems-channel {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--sp-3);
    padding-inline-start: var(--sp-3);
    border-left: 1px solid var(--line-inv);
  }

  .stems-track-select {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-2);
    min-height: 44px;
    color: var(--on-ink-2);
    text-align: start;
    transition: color var(--dur-hover) var(--ease-out);
  }

  .stems-track-dot {
    width: 6px;
    height: 6px;
    background: var(--line-inv-strong);
    flex-shrink: 0;
    transition: background-color var(--dur-hover) var(--ease-out);
  }

  .stems-track-select[aria-pressed='true'] {
    color: var(--on-ink);
  }

  .stems-track-select[aria-pressed='true'] .stems-track-dot {
    background: var(--state);
  }

  /* Level meter: compositor-only. The bar is full height and scaled with
     transform: scaleY() from the bottom (stems-console.ts sets the inline
     style); the fill's opacity carries intensity. One 1px line per strip. */
  .stems-meter-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    height: 96px;
  }

  .stems-meter-bar {
    position: relative;
    flex: 1;
    width: 1px;
    background: var(--line-inv-strong);
    transform: scaleY(0.12);
    transform-origin: bottom;
    transition: transform 80ms linear;
  }

  .stems-meter-fill {
    position: absolute;
    inset: 0;
    background: var(--on-ink);
    opacity: 0;
    transition: opacity 100ms linear;
  }

  .stems-meter-abbr {
    color: var(--on-ink-2);
  }

  .stems-track-mute {
    min-height: 44px;
    color: var(--on-ink-2);
    border-top: 1px solid var(--line-inv);
    padding-top: var(--sp-2);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .stems-track-mute[aria-pressed='true'] {
    color: var(--state);
  }

  /* ---------- FX panel ---------- */
  .stems-fx {
    padding: var(--sp-4);
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .stems-fx-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--on-ink-2);
  }

  .stems-fx-active {
    color: var(--state);
  }

  .stems-fx-panel {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .fx-row {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .fx-row-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .fx-row-head label {
    color: var(--on-ink-2);
  }

  .fx-row-value {
    color: var(--on-ink);
  }

  .fx-slider,
  #master-vol {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 1px;
    min-height: 44px;
    background: transparent;
    padding-block: 20px;
  }

  .fx-slider::-webkit-slider-runnable-track,
  #master-vol::-webkit-slider-runnable-track {
    height: 1px;
    background: var(--line-inv-strong);
  }

  .fx-slider::-webkit-slider-thumb,
  #master-vol::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    margin-top: -7px;
    width: 15px;
    height: 15px;
    background: var(--on-ink);
    border: 2px solid var(--ink-ground);
  }

  .fx-slider::-moz-range-track,
  #master-vol::-moz-range-track {
    height: 1px;
    background: var(--line-inv-strong);
  }

  .fx-slider::-moz-range-thumb,
  #master-vol::-moz-range-thumb {
    width: 15px;
    height: 15px;
    background: var(--on-ink);
    border: 2px solid var(--ink-ground);
    border-radius: 0;
  }

  /* ---------- Master transport ---------- */
  .stems-master {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--line-inv);
  }

  .stems-master-play {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .stems-play-btn {
    width: 44px;
    height: 44px;
    padding: 0;
    border-color: var(--on-ink);
    color: var(--on-ink);
  }

  .stems-play-btn[aria-pressed='true'] {
    background: var(--state);
    color: var(--ink);
  }

  .stems-status {
    color: var(--on-ink);
  }

  .stems-master-vol {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex: 1;
    max-width: 220px;
    min-width: 160px;
    justify-content: flex-end;
  }

  .stems-master-vol label {
    color: var(--on-ink-2);
    white-space: nowrap;
  }

  /* Phones: five strips can't hold '05. Vocals' at 360-390, so the strips
   * wrap onto a second row instead of clipping their labels. */
  @media (max-width: 599px) {
    .stems-mixer {
      grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
      row-gap: var(--sp-5);
    }

    .stems-channel {
      min-width: 0;
    }

    .stems-track-select .t-label {
      white-space: normal;
      overflow-wrap: normal;
    }
  }

  @media (min-width: 1024px) {
    .music-inner {
      display: grid;
      grid-template-columns: repeat(var(--bays), 1fr);
      column-gap: var(--g);
      align-items: start;
    }

    .music-copy {
      grid-column: 1 / span 1;
    }

    .stems-console {
      grid-column: 2 / span 3;
    }
  }
</style>

<script>
  import { initStemsConsole } from '../../scripts/home/stems-console';
  initStemsConsole();
</script>
