---
/**
 * SignalScope — the one signature WebGL moment (direction A). A field of
 * thin oscilloscope traces: idle mode (home hero) is seeded from the real
 * Silver Linings stem envelope and bows toward the cursor; audio mode
 * (/music masthead) drives the same traces from a live AnalyserNode via
 * src/webgl/scope.ts's attachAnalyser() (wired up in Phase 5).
 *
 * A static inline SVG poster — calibration ticks + traces drawn from the
 * SAME envelope data, at build time, right here — is always in the DOM and
 * visible. The canvas fades in over it only once WebGL is actually
 * running; the poster alone is what reduced-motion, no-JS and a
 * webglcontextlost fallback all show.
 *
 * Perf: src/webgl/scope.ts is never imported until this component's own
 * inline script (below) sees the host intersect the viewport AND the page
 * has finished loading (requestIdleCallback, falling back to setTimeout),
 * and never at all under prefers-reduced-motion: reduce.
 */
import envelopeRaw from '../data/scope-envelope.json';

interface Props {
  mode?: 'idle' | 'audio';
  traces?: number;
  class?: string;
}

const { mode = 'idle', traces = 7, class: className } = Astro.props;

type Stem = { name: string; envelope: number[] };
const envelope = envelopeRaw as { stems: Stem[] };
const stems = envelope.stems;

const W = 800;
const H = 360;
const TOP_MARGIN = 24;
const BOTTOM_MARGIN = 24;
const trackHeight = H - TOP_MARGIN - BOTTOM_MARGIN;

// Colour + line-style assignment mirrors src/webgl/scope.ts's palette so
// the poster and the live canvas read as the same instrument at a glance.
const COLORS = ['var(--text)', 'var(--accent-2)', 'var(--text-muted)', 'var(--text)', 'var(--text-muted)'];
const DASH = ['none', 'none', '1 3', '0.5 4', '1 3'];

function toPoints(stemEnvelope: number[], index: number, count: number) {
  const baselineY = TOP_MARGIN + (trackHeight * (index + 0.5)) / count;
  const amp = (trackHeight / count) * 0.42;
  return stemEnvelope
    .map((v, i) => {
      const x = (i / (stemEnvelope.length - 1)) * W;
      const y = baselineY - (v - 0.5) * amp * 2;
      return `${x.toFixed(1)},${y.toFixed(1)}`;
    })
    .join(' ');
}

const tickCount = 10;
const ticks = Array.from({ length: tickCount + 1 }, (_, i) => ({
  x: (i / tickCount) * W,
  major: i % 5 === 0,
}));
---

<div class:list={['signal-scope', className]} data-scope data-scope-mode={mode} data-scope-traces={traces}>
  <svg class="scope-poster" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <g class="scope-poster__ticks" stroke="var(--line)" stroke-width="1">
      {ticks.map((tick) => (
        <line x1={tick.x} x2={tick.x} y1={tick.major ? 0 : H - 12} y2={H} />
      ))}
    </g>
    <g class="scope-poster__traces" fill="none" stroke-width="1">
      {stems.map((stem, i) => (
        <polyline
          points={toPoints(stem.envelope, i, stems.length)}
          stroke={COLORS[i % COLORS.length]}
          stroke-dasharray={DASH[i % DASH.length]}
          opacity="0.8"
        />
      ))}
    </g>
  </svg>
  <canvas aria-hidden="true" tabindex="-1"></canvas>
</div>

<style>
  .signal-scope {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 240px;
    overflow: hidden;
  }
  .scope-poster {
    display: block;
    width: 100%;
    height: 100%;
  }
  .scope-poster__traces polyline {
    vector-effect: non-scaling-stroke;
  }
</style>

<script>
  // Runs once per page even if SignalScope is used more than once on it
  // (e.g. never today, but keeps the component instance-safe).
  function boot(host: HTMLElement) {
    const canvas = host.querySelector('canvas');
    if (!canvas) return;
    const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
    if (reduceMq.matches) return;
    let stopped = false;
    // Switching the OS setting to reduce later tears WebGL down; the poster
    // shows again because destroy() drops .is-running.
    reduceMq.addEventListener(
      'change',
      (e) => {
        if (!e.matches) return;
        stopped = true;
        (host as HTMLElement & { __scopeController?: { destroy(): void } }).__scopeController?.destroy();
      },
      { once: true },
    );

    let started = false;
    const start = async () => {
      if (started || stopped) return;
      started = true;
      try {
        const { initScope } = await import('../webgl/scope.ts');
        const mode = host.dataset.scopeMode === 'audio' ? 'audio' : 'idle';
        const traces = Number(host.dataset.scopeTraces) || 7;
        if (stopped) return;
        const controller = initScope(canvas as HTMLCanvasElement, { mode, traces });
        (host as HTMLElement & { __scopeController?: unknown }).__scopeController = controller;
      } catch {
        // WebGL unavailable/failed to init: the poster stays visible, and
        // is:running is simply never added, which is the correct fallback.
      }
    };

    const idle = (cb: () => void) =>
      'requestIdleCallback' in window ? (window as any).requestIdleCallback(cb) : setTimeout(cb, 200);

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          io.disconnect();
          if (document.readyState === 'complete') idle(start);
          else window.addEventListener('load', () => idle(start), { once: true });
        });
      },
      { threshold: 0.1 },
    );
    io.observe(host);
  }

  document.querySelectorAll<HTMLElement>('[data-scope]').forEach(boot);
</script>
