---
/**
 * CH-02 work hub — the 3 legacy panels (work.json `panels`, sourced from
 * work.copy.032-040 + work.video.042-044). Direction D (Phase 2b, carried
 * into Phase 4): full-bleed stacked `data-hot` index rows, each with a
 * B2-B4 mega title (D-brutalist-grid.md §5.7), separated by
 * `Rule data-rule-cross`. An INDEX/INFORMATION toggle switches between the
 * expanded view (title, description, media) and a compact numbered list;
 * both states stay in the DOM at all times (CSS-only display toggle), so
 * the page is complete with JS off (default view is INFORMATION) and under
 * prefers-reduced-motion.
 *
 * Row titles ("Projects"/"AI"/"Experiments", work.h.021-023 — h3 in the
 * legacy DOM) render as h2 here: the DOM parity checker matches by text
 * only (never heading level), and h2 keeps a clean h1 → h2 sequence with no
 * skipped level, since there is no intervening section heading.
 *
 * Preview video (≥1024, fine pointer): hover-only, intent-delayed and
 * locked to bay 4 — the same language as home's FeaturedWorkIndex
 * (D-brutalist-grid.md §4.2/§5.7); src is set on pointer intent and removed
 * again on leave so an abandoned hover stops downloading. Below 1024 (and
 * on any coarse/no-hover pointer) the media shows inline instead, playing
 * on scroll intersection. Every row's poster comes from the shared media
 * manifest (src/data/media.json via projects/media.ts's resolveVideo, never
 * duplicated here) so the box is never an empty grey rectangle before the
 * clip decodes, and under prefers-reduced-motion the clip never loads or
 * plays — hover/scroll only ever reveals the static poster. hub.ts owns all
 * of this plus the toggle's GSAP Flip transition and each title's wdth
 * hover (gsap.quickTo on --rwdth).
 */
import type { WorkPanel } from '../../content';
import Icon from '../Icon.astro';
import Rule from '../grid/Rule.astro';
import { resolveVideo } from '../projects/media';

interface Props {
  panels: WorkPanel[];
}

const { panels } = Astro.props;

function fixHref(href: string | null): string {
  if (!href) return '#';
  return href === '/ai' ? '/AI' : href;
}

function poster(panel: WorkPanel): { src: string | null; w: number; h: number } | null {
  if (panel.media.type !== 'video' || !panel.media.src) return null;
  const resolved = resolveVideo(panel.media.src);
  return { src: resolved.poster, w: resolved.w, h: resolved.h };
}
---

<div class="container work-toggle-wrap">
<div class="work-toggle" role="group" aria-label="View">
  <button type="button" class="work-toggle-btn" data-view-btn="information" aria-pressed="true">
    <span class="t-label">INFORMATION</span>
  </button>
  <button type="button" class="work-toggle-btn" data-view-btn="index" aria-pressed="false">
    <span class="t-label">INDEX</span>
  </button>
</div>
</div>

<ol class="work-index" data-work-view="information">
  {
    panels.map((panel, i) => {
      const media = poster(panel);
      return (
        <li>
          <Rule origin="start" cross />
          <a
            href={fixHref(panel.href)}
            class="work-row"
            data-hot
            data-work-row
            data-work-row-src={panel.media.src ?? undefined}
          >
            <span class="container work-row-inner">
              <span
                class:list={[
                  'work-row-preview',
                  'work-view-expanded-only',
                  panel.media.type === 'video' && 'has-video',
                ]}
                aria-hidden="true"
              >
                {panel.media.type === 'video' && (
                  <video
                    data-work-row-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    tabindex="-1"
                    poster={media?.src ?? undefined}
                    width={media?.w ?? 640}
                    height={media?.h ?? 360}
                  />
                )}
              </span>

              <span class="work-row-num t-label" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>

              <span class="work-row-body">
                {panel.eyebrow && <span class="t-label work-row-eyebrow work-view-expanded-only">{panel.eyebrow}</span>}
                <h2 class="t-h1 work-row-title">{panel.title}</h2>
              </span>

              <span class="work-row-meta work-view-expanded-only">
                {panel.desc && <span class="t-body work-row-desc">{panel.desc}</span>}
                <span class="work-row-cta t-label" aria-hidden="true">
                  <Icon name="arrow" size={16} class="work-row-arrow" />
                </span>
              </span>
            </span>
          </a>
        </li>
      );
    })
  }
</ol>
<Rule origin="start" cross />

<style>
  .work-toggle {
    display: inline-flex;
    border: 1px solid var(--ink);
    margin-block-end: var(--sp-6);
  }

  .work-toggle-btn {
    padding: var(--sp-2) var(--sp-4);
    min-height: 44px;
    min-width: 44px;
    color: var(--ink-2);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .work-toggle-btn + .work-toggle-btn {
    border-inline-start: 1px solid var(--ink);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-toggle-btn:hover {
      color: var(--ink);
    }
  }

  .work-toggle-btn[aria-pressed='true'] {
    color: var(--ink);
    background: var(--state);
  }

  /* No JS: the toggle can't do anything, so it isn't shown. */
  :global(html:not(.js)) .work-toggle-wrap {
    display: none;
  }

  .work-index {
    display: flex;
    flex-direction: column;
  }

  .work-row {
    position: relative;
    display: block;
    width: 100vw;
    margin-inline: calc(50% - 50vw);
    min-height: 60svh;
    color: var(--ink);
    overflow: hidden;
  }

  .work-row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--state);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-hover) var(--ease-step);
    z-index: -1;
  }

  @media (hover: hover) and (pointer: fine) {
    .work-row:hover::before,
    .work-row:focus-visible::before {
      transform: scaleX(1);
    }
  }

  .work-row:focus-visible {
    outline: 2px solid var(--ink);
    outline-offset: -3px;
  }

  .work-row-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--sp-4);
    min-height: inherit;
    padding-block: var(--sp-7);
  }

  .work-row-num {
    color: var(--ink-2);
  }

  .work-row-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    max-width: 90%;
  }

  .work-row-eyebrow {
    color: var(--ink-2);
  }

  /* Sized to fit the longest title ('Experiments') on one line in its
   * column: never a mid-word break. */
  .work-row-body {
    container-type: inline-size;
  }

  .work-row-title {
    color: var(--ink);
    /* --rwdth: the hover wdth kinetic (hub.ts, gsap.quickTo). Falls back to
     * its resting 100 with no JS. */
    font-variation-settings: 'wdth' var(--rwdth, 100), 'wght' 820;
    font-size: min(var(--fs-h1), 13cqi);
    overflow-wrap: normal;
    hyphens: none;
  }

  .work-row-meta {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    max-width: 46ch;
  }

  .work-row-desc {
    color: var(--ink-2);
  }

  .work-row-cta {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .work-row-arrow {
    transition: transform var(--dur-hover) var(--ease-out);
  }

  .work-row:focus-visible .work-row-arrow {
    transform: translateX(4px);
  }

  @media (hover: hover) and (pointer: fine) {
    .work-row:hover .work-row-arrow {
      transform: translateX(4px);
    }
  }

  .work-row-preview {
    display: none;
  }

  /* <1024 (no bay 4 to lock to — the grid is at most 2 bays below that):
   * the media shows inline at 16:10 above the row text, playing on scroll
   * intersection (hub.ts). Without JS there's nothing to load, so the box
   * only exists under html.js, and the row sizes to its content instead of
   * a mostly-empty 60svh. */
  @media (max-width: 1023px) {
    .work-row {
      min-height: auto;
    }

    :global(html.js) .work-row-preview.has-video {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: var(--paper-2);
      clip-path: inset(0 0 100% 0);
      transition: clip-path 900ms var(--ease-out);
    }

    .work-row.is-revealed .work-row-preview.has-video {
      clip-path: inset(0 0 0 0);
    }

    .work-row-preview video {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  /* ≥1024: the row sits on the bay grid (B1 index number, B2-B4 mega
   * title), and the media is a hover-only preview locked to bay 4 — never
   * a permanently reserved empty box — the same language as home's
   * FeaturedWorkIndex (D-brutalist-grid.md §4.2/§5.7). */
  @media (min-width: 1024px) {
    /* The mega title now carries most of the row's visual weight, so the
     * row itself needs far less reserved height than the <1024 60svh
     * figure (that was leaving each row mostly empty — the "wireframe-
     * sparse" complaint). */
    [data-work-view='information'] .work-row {
      min-height: 42svh;
    }

    [data-work-view='information'] .work-row-inner {
      position: relative;
      display: grid;
      grid-template-columns: repeat(var(--bays), 1fr);
      column-gap: var(--g);
      row-gap: var(--sp-4);
      align-items: start;
    }

    .work-row-num {
      grid-column: 1;
      grid-row: 1;
      padding-top: 0.4em;
    }

    .work-row-body {
      grid-column: 2 / span 3;
      grid-row: 1;
      max-width: none;
    }

    .work-row-title {
      font-size: min(var(--fs-mega), 14cqi);
    }

    .work-row-meta {
      grid-column: 2 / span 3;
      grid-row: 2;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--sp-5);
      max-width: none;
    }

    .work-row-desc {
      max-width: 60ch;
    }

    .work-row-preview.has-video {
      display: block;
      position: absolute;
      z-index: 2;
      top: -30%;
      right: 0;
      width: calc((100% - 3 * var(--g)) / 4);
      height: 160%;
      overflow: hidden;
      border: 1px solid var(--ink);
      background: var(--paper-2);
      pointer-events: none;
      clip-path: inset(0 0 100% 0);
      transition: clip-path var(--dur-reveal) var(--ease-out);
    }

    .work-row.is-playing .work-row-preview.has-video {
      clip-path: inset(0 0 0 0);
    }

    .work-row-preview video {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .work-row-preview.has-video {
      transition: none;
    }
  }

  /* INDEX view: numbered rows only, compact. Content stays in the DOM —
     only display toggles — so parity and screen-reader reachability from
     the INFORMATION view are never affected. */
  [data-work-view='index'] .work-view-expanded-only {
    display: none;
  }

  [data-work-view='index'] .work-row {
    min-height: auto;
  }

  [data-work-view='index'] .work-row-inner {
    flex-direction: row;
    align-items: baseline;
    gap: var(--sp-5);
    padding-block: var(--sp-4);
  }

  [data-work-view='index'] .work-row-title {
    font-size: var(--fs-row);
    line-height: var(--lh-row);
    letter-spacing: var(--ls-row);
  }

  [data-work-view='index'] .work-row-inner {
    max-width: none;
  }

  [data-work-view='index'] .work-row-body {
    container-type: normal;
    flex: 1;
  }
</style>

<script>
  import { initWorkHub } from '../../scripts/work/hub';
  initWorkHub();
</script>
