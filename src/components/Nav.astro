---
import { NAV_ITEMS, LOGO } from '../data/site';
import GridFrame from './grid/GridFrame.astro';
import Rule from './grid/Rule.astro';
import MobileMenu from './MobileMenu.astro';

interface Props {
  current: string;
}

const { current } = Astro.props;

function isCurrent(path: string, current: string) {
  if (path === '/') return current === '/';
  return current === path || current.startsWith(`${path}/`);
}
---

<header class="nav" id="nav">
  <GridFrame local />
  <div class="nav-inner container">
    <div class="nav-brand">
      <a href="/" class="nav-logo" aria-label="William Vernon — home">
        <img src={LOGO.src} alt={LOGO.alt} width="28" height="28" class="nav-logo-img" />
        <span class="nav-logo-text t-label">William Vernon</span>
      </a>
    </div>

    <nav aria-label="Primary" class="nav-links-wrap">
      <ul class="nav-links">
        {
          NAV_ITEMS.map((item) => (
            <li>
              <a
                href={item.path}
                aria-current={isCurrent(item.path, current) ? 'page' : undefined}
                class="nav-link t-label"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <MobileMenu current={current} />
  </div>
  <Rule origin="start" class="nav-rule" />
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    /* §5.1: the nav stays put under the page cut (unique name). */
    view-transition-name: nav;
    z-index: var(--z-nav);
    background: var(--paper);
  }

  .nav-inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    min-height: 64px;
  }

  /* The bay split only makes sense once there's more than one bay to split
   * across (≥1024, 4 bays): brand in bay 1, links across bays 2-4. Below
   * that, flex space-between (above) keeps brand/trigger at the row ends
   * regardless of the single active bay. */
  @media (min-width: 1024px) {
    .nav-inner {
      display: grid;
      grid-template-columns: repeat(var(--bays), 1fr);
      column-gap: var(--g);
      justify-content: normal;
    }

    .nav-brand {
      grid-column: span 1;
    }
  }

  .nav-brand {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .nav-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    min-height: 44px;
    color: var(--ink);
  }

  .nav-logo-img {
    display: block;
    filter: invert(1);
  }

  .nav-logo-text {
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .nav-links-wrap {
    display: none;
  }

  .nav-links {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-6);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: var(--sp-2);
    color: var(--ink-2);
    transition: color var(--dur-hover) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link:focus-visible {
    color: var(--ink);
  }

  .nav-link[aria-current='page'] {
    color: var(--ink);
    background: var(--state);
  }

  @media (min-width: 1024px) {
    .nav-links-wrap {
      display: block;
      grid-column: span 3;
    }
  }

  /* No JS (or the head failsafe dropped html.js): the disclosure menu can't
   * open below 1024, so the link list shows inline and wraps instead. */
  @media (max-width: 1023px) {
    :global(html:not(.js)) .nav-inner {
      display: flex;
      flex-wrap: wrap;
    }
    :global(html:not(.js)) .nav-links-wrap {
      display: block;
      order: 3;
      flex-basis: 100%;
    }
    :global(html:not(.js)) .nav-links {
      flex-wrap: wrap;
      justify-content: flex-start;
      gap: 0 var(--sp-5);
    }
  }
</style>
