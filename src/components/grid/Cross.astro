---
/**
 * A standalone "+" registration mark (hero H1 box corners, 404). Same visual
 * as Rule's `.rule-x`, just not tied to a bay position — placed by its
 * parent's own layout (e.g. `position: absolute` corners on the hero box).
 */
interface Props {
  class?: string;
  /** Opt in to the stepped pop-in (motion.css pre-hides it, lines.ts pops it
   * in). Leave off for crosses that are UI state (e.g. accordion icons) and
   * own their transform. Offset a popped cross with margins, never a
   * transform/translate (GSAP owns its transform). */
  pop?: boolean;
}

const { class: className = '', pop = false } = Astro.props;
---

<span class:list={['cross', className]} data-cross-pop={pop ? '' : undefined} aria-hidden="true"></span>

<style>
  .cross {
    position: relative;
    display: inline-block;
    width: 11px;
    height: 11px;
  }

  .cross::before,
  .cross::after {
    content: '';
    position: absolute;
    background: var(--line-strong);
  }
  .cross::before {
    top: 5px;
    left: 0;
    right: 0;
    height: 1px;
  }
  .cross::after {
    left: 5px;
    top: 0;
    bottom: 0;
    width: 1px;
  }
</style>
