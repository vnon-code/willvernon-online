---
// A real disclosure button + full-screen menu dialog. Works entirely on CSS
// transitions and vanilla JS — no GSAP dependency, so the menu is usable even
// if src/motion/index.ts fails to load. Icons are inline SVG (no icon font).
import { NAV_ITEMS, SOCIAL_LINKS } from '../data/site';
import Icon from './Icon.astro';
import Rule from './grid/Rule.astro';

interface Props {
  current: string;
}

const { current } = Astro.props;

function isCurrent(path: string, current: string) {
  if (path === '/') return current === '/';
  return current === path || current.startsWith(`${path}/`);
}
---

<button
  type="button"
  class="menu-trigger t-label"
  id="menu-trigger"
  aria-expanded="false"
  aria-controls="mobile-menu"
  aria-label="Open menu"
>
  <span class="menu-trigger-label-open">Menu</span>
  <span class="menu-trigger-label-close">Close</span>
  <span class="menu-trigger-icon-open"><Icon name="menu" size={20} /></span>
  <span class="menu-trigger-icon-close"><Icon name="close" size={20} /></span>
</button>

<div class="mobile-menu" id="mobile-menu" role="dialog" aria-modal="true" aria-label="Site navigation" hidden>
  <div class="mobile-menu-inner">
    <button type="button" class="mobile-menu-close" data-menu-close aria-label="Close menu">
      <Icon name="close" size={22} />
    </button>
    <nav aria-label="Primary" class="mobile-menu-nav">
      <ul class="mobile-menu-links">
        {
          NAV_ITEMS.map((item, i) => (
            <li>
              {i > 0 && <Rule origin="start" />}
              <a
                href={item.path}
                class="mobile-menu-link t-h1"
                aria-current={isCurrent(item.path, current) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ul class="mobile-menu-socials" aria-label="Social links">
      {
        SOCIAL_LINKS.map((social) => (
          <li>
            <a
              href={social.href}
              target={social.href.startsWith('http') ? '_blank' : undefined}
              rel={social.href.startsWith('http') ? 'noopener noreferrer' : undefined}
              aria-label={social.label}
            >
              <Icon name={social.icon} size={20} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .menu-trigger {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 44px;
    padding-inline: var(--sp-2);
    color: var(--ink);
  }

  .menu-trigger-label-close,
  .menu-trigger-icon-close {
    display: none;
  }

  .menu-trigger[aria-expanded='true'] .menu-trigger-label-open,
  .menu-trigger[aria-expanded='true'] .menu-trigger-icon-open {
    display: none;
  }
  .menu-trigger[aria-expanded='true'] .menu-trigger-label-close,
  .menu-trigger[aria-expanded='true'] .menu-trigger-icon-close {
    display: inline-flex;
  }

  @media (min-width: 1024px) {
    .menu-trigger {
      display: none;
    }
  }

  /* No JS (or the head failsafe dropped html.js): the burger can't work, so
   * Nav.astro shows the inline link list instead. */
  :global(html:not(.js)) .menu-trigger {
    display: none;
  }

  .mobile-menu-close {
    position: absolute;
    top: 10px;
    left: var(--m);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink);
  }

  .mobile-menu-close:hover,
  .mobile-menu-close:focus-visible {
    color: var(--ink-2);
  }

  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: var(--z-menu);
    background: var(--paper);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: var(--sp-9) var(--m) var(--sp-6);
    overflow-y: auto;
    opacity: 0;
    transition: opacity var(--dur-page) var(--ease-step);
  }

  .mobile-menu:not([data-open]) {
    pointer-events: none;
  }

  .mobile-menu[data-open] {
    opacity: 1;
  }

  .mobile-menu[hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none !important;
    }
  }

  .mobile-menu-inner {
    display: contents;
  }

  .mobile-menu-nav {
    margin-block: auto;
  }

  .mobile-menu-links {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu-link {
    display: block;
    padding-block: var(--sp-3);
    color: var(--ink);
  }

  .mobile-menu-link[aria-current='page'] {
    background: var(--state);
  }

  .mobile-menu-socials {
    display: flex;
    gap: var(--sp-6);
    padding-top: var(--sp-6);
  }

  .mobile-menu-socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    color: var(--ink-2);
  }

  .mobile-menu-socials a:hover,
  .mobile-menu-socials a:focus-visible {
    color: var(--ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  // Vanilla JS disclosure + focus trap. No GSAP dependency by design, so the
  // menu keeps working even if the motion module fails to load.
  const trigger = document.getElementById('menu-trigger') as HTMLButtonElement | null;
  const menu = document.getElementById('mobile-menu') as HTMLElement | null;

  if (trigger && menu) {
    let lastFocused: HTMLElement | null = null;

    const focusableSelector =
      'a[href], button:not([disabled]), input, textarea, select, [tabindex]:not([tabindex="-1"])';

    function getFocusable(): HTMLElement[] {
      return Array.from(menu!.querySelectorAll<HTMLElement>(focusableSelector));
    }

    let finishTimer: number | undefined;
    let pendingFinish: (() => void) | null = null;

    function cancelPendingClose() {
      if (finishTimer !== undefined) window.clearTimeout(finishTimer);
      finishTimer = undefined;
      if (pendingFinish) menu!.removeEventListener('transitionend', pendingFinish);
      pendingFinish = null;
    }

    function openMenu() {
      cancelPendingClose();
      lastFocused = document.activeElement as HTMLElement;
      menu!.hidden = false;
      // next frame so the transition runs from the hidden state
      requestAnimationFrame(() => {
        menu!.setAttribute('data-open', '');
      });
      trigger!.setAttribute('aria-expanded', 'true');
      trigger!.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      const focusable = getFocusable();
      (focusable[0] ?? menu)!.focus();
      document.addEventListener('keydown', onKeydown);
    }

    function closeMenu() {
      cancelPendingClose();
      menu!.removeAttribute('data-open');
      trigger!.setAttribute('aria-expanded', 'false');
      trigger!.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      const finish = () => {
        cancelPendingClose();
        // a reopen in the meantime wins
        if (trigger!.getAttribute('aria-expanded') === 'true') return;
        menu!.hidden = true;
      };
      pendingFinish = finish;
      // match the CSS transition duration as a fallback if transitionend
      // doesn't fire (e.g. reduced motion collapses it to ~0ms)
      menu!.addEventListener('transitionend', finish, { once: true });
      finishTimer = window.setTimeout(finish, 450);
      // the menu may have been opened from inside itself; always land on the
      // trigger, which is visible again once the dialog closes
      const back = lastFocused && !menu!.contains(lastFocused) ? lastFocused : trigger;
      back!.focus();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') {
        e.preventDefault();
        closeMenu();
        return;
      }
      if (e.key === 'Tab') {
        const focusable = getFocusable();
        if (focusable.length === 0) return;
        const first = focusable[0];
        const last = focusable[focusable.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    }

    trigger.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      if (isOpen) closeMenu();
      else openMenu();
    });

    menu.querySelector('[data-menu-close]')?.addEventListener('click', closeMenu);

    // Tap on the dialog's empty area (not on a link/button) closes it too.
    menu.addEventListener('click', (e) => {
      const t = e.target as HTMLElement;
      if (!t.closest('a, button')) closeMenu();
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        // let the navigation proceed; just reset state/scroll lock
        document.body.style.overflow = '';
      });
    });
  }
</script>
