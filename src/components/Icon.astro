---
// Inline SVG icon subset — hand-authored minimal line/mark set, no icon font,
// no runtime CDN. Only the glyphs Phase 2 actually needs.
interface Props {
  name:
    | 'instagram'
    | 'linkedin'
    | 'envelope'
    | 'soundcloud'
    | 'bandcamp'
    | 'tiktok'
    | 'arrow'
    | 'menu'
    | 'close';
  size?: number;
  class?: string;
}

const { name, size = 20, class: className = '' } = Astro.props;
---

{
  name === 'instagram' && (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      class={className}
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4.4" />
      <circle cx="17.2" cy="6.8" r="1" fill="currentColor" stroke="none" />
    </svg>
  )
}
{
  name === 'linkedin' && (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      class={className}
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      aria-hidden="true"
      focusable="false"
    >
      <rect x="3" y="3" width="18" height="18" rx="3" />
      <circle cx="7.6" cy="8" r="0.9" fill="currentColor" stroke="none" />
      <path d="M7.6 11v6" stroke-linecap="round" />
      <path
        d="M11.6 17v-3.6c0-1.5 1-2.4 2.2-2.4s2 .9 2 2.3V17"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
      <path d="M11.6 11v6" stroke-linecap="round" />
    </svg>
  )
}
{
  name === 'envelope' && (
    <svg
      viewBox="0 0 24 24"
      width={size}
