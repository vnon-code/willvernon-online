      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M5 12h13.5M13 6.5 18.5 12 13 17.5" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  )
}
{
  name === 'menu' && (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      class={className}
      fill="none"
