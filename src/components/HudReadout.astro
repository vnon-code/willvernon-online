---
// A telemetry readout. Markup only — src/motion/index.ts (builder B) owns the
// update loop keyed off the data-hud attribute. Values are real state
// (scroll %, clock, cursor XY, armed track BPM), never decorative filler.
interface Props {
  variant: 'scroll' | 'clock' | 'xy' | 'bpm';
  /** Accessible label read once; the live digits stay out of the a11y tree
      so a ≤10fps tick doesn't spam screen readers with numbers no one asked for. */
  label?: string;
  class?: string;
}

const { variant, label, class: className = '' } = Astro.props;

const DEFAULTS: Record<Props['variant'], { label: string; value: string }> = {
  scroll: { label: 'Scroll position', value: '000' },
  clock: { label: 'Local time', value: '00:00:00' },
  xy: { label: 'Cursor position', value: '0000,0000' },
  bpm: { label: 'Track tempo', value: '---' },
};

const resolved = DEFAULTS[variant];
const resolvedLabel = label ?? resolved.label;
---

<span class:list={['hud-readout', className]}>
  <span class="sr-only">{resolvedLabel}</span>
  <span class="hud-readout-value t-mono" data-hud={variant} aria-hidden="true">{resolved.value}</span>
</span>

<style>
  .hud-readout {
    display: inline-flex;
    align-items: baseline;
  }

  .hud-readout-value {
    color: var(--text-muted);
  }
</style>
