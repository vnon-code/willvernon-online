     "Serverless CDN",
     "Vanilla CSS"
    ],
    "mediaHtml": "<div class=\"carousel-container\"><div class=\"carousel-slide active\" style=\"display:flex; align-items:center; justify-content:center; background:#030303;\"><img src=\"img/monogram-white-trans.png\" style=\"width:120px; height:auto; opacity:0.8; filter:drop-shadow(0 0 20px rgba(217, 28, 28, 0.4));\" alt=\"WV Monogram Rebuild\"></div></div>",
    "desc": "This website is the product of a genuine collaboration between myself and Antigravity AI. Rather than just using AI to generate assets, I pair-programmed the entire site rebuild with it — working through layout decisions, solving real deployment problems like audio streaming and file hosting, and iterating on the design together. It was a proper test of what AI-assisted web development actually looks like day to day.",
    "prompt": "Pair programming interaction: William Vernon (Artistic Direction & structural sketches) + Antigravity (Advanced Agentic CSS grid restoration, CORS XML header parser, boto3 media staging automated scripting, HTML responsive drawers)",
    "engine": "Antigravity AI + Gemini Canvas Workspace",
    "ar": "Pure Vanilla HTML5 / CSS3 Grid",
    "style": "Agentic Collaboration Flow",
    "upscale": "Cloudflare Edge Global Cache (100ms load)"
   }
