  "AI_DATA": {
   "dredge": {
    "title": "DREDGE",
    "meta": "[ MIDJOURNEY_V6 // FLUID_DYNAMICS ]",
    "tags": [
     "Midjourney V6",
     "Oceanic Scale",
     "Luma Dream Machine",
     "Light Scatter"
    ],
    "mediaHtml": "<div class=\"carousel-container\"><div class=\"carousel-slide active\"><video src=\"https://assets.willvernon.online/ai/dredge_outcome_full.mp4\" controls autoplay muted loop playsinline></video></div></div>",
    "desc": "The same concept as Monolith Survival but applied to deep-sea fishing. I wanted to build a mock campaign for heavy-duty oceanic workwear — waterproof jackets, thick gloves, industrial gear — set against dramatic underwater backdrops. Midjourney generated the stills of bioluminescent creatures and dark open water, then I used video interpolation to bring those scenes to life. The idea was to see if AI could produce something that felt like a real brand campaign for a world that doesn't exist yet.",
    "prompt": "ultra-realistic cinematic photography of a massive bioluminescent white whale leaping from the abyssal ocean, glowing internal light grid, deep volumetric light rays piercing underwater, heavy particles, slow-motion bubbles, high-detail water textures, octane render, Arri Alexa style --ar 2.35:1 --style raw --v 6.0",
    "engine": "Midjourney V6 + Frame Interpolation",
    "ar": "--ar 2.35:1",
    "style": "--style raw --v 6.0",
    "upscale": "Upscaled Creative 2x"
   },
   "monolith": {
    "title": "Monolith Survival",
    "meta": "[ GORPCORE_AE // CAM_VECTORS ]",
    "tags": [
     "Midjourney V6",
     "Gorpcore Aesthetic",
     "Luma Dream Machine",
     "Slow Motion"
    ],
    "mediaHtml": "<div class=\"carousel-container\"><div class=\"carousel-slide active\"><video src=\"https://assets.willvernon.online/ai/MONOLITH_SURVIVAL_outcome.mp4\" controls autoplay muted loop playsinline></video></div></div>",
    "desc": "I wanted to see how close AI could get to producing a convincing outdoor gear campaign. The concept was a fictional brand called Monolith Survival — rugged boots, stone landscapes, slow-motion impact shots. Midjourney handled the stills and Luma Dream Machine turned them into sweeping camera movements. The results genuinely looked like something from a real campaign shoot, which was the whole point of the experiment.",
    "prompt": "social_u7329539893_httpss.mj.runS83Gb2M2trU_the_shoe_stomps_the_ground --ar 9:16 --style raw --v 6.0 (High-motion hiking boot technical gorpcore campaign, massive stone monolith background, slow-motion splash, camera orbits technical shoe)",
    "engine": "Midjourney V6 + Luma Dream Machine",
    "ar": "--ar 9:16",
    "style": "--style raw --v 6.0",
    "upscale": "Upscaled Creative 2x"
   },
   "synthetic_corals": {
    "title": "Synthetic Corals",
    "meta": "[ COMFYUI_NODE // HIDREAM_CORE // CLOUDFLARE_R2 ]",
    "tags": [
     "ComfyUI",
     "HiDream weights",
     "Flux.1 Dev",
     "Bioluminescent",
     "Multi-Outcome"
    ],
    "mediaHtml": "\n                    <div class=\"carousel-container\">\n                        <!-- Carousel Slides -->\n                        <div class=\"carousel-slide active\" data-index=\"0\">\n                            <video src=\"https://assets.willvernon.online/ai/coral_rotate.mp4\" controls autoplay muted loop playsinline></video>\n                        </div>\n                        <div class=\"carousel-slide\" data-index=\"1\">\n                            <video src=\"https://assets.willvernon.online/ai/coral_rotate_vertical.mp4\" controls autoplay muted loop playsinline></video>\n                        </div>\n                        <div class=\"carousel-slide\" data-index=\"2\">\n                            <img src=\"https://assets.willvernon.online/ai/synthetic_corals_1.jpg\" alt=\"Synthetic Coral 1 - White Calcification\">\n                        </div>\n                        <div class=\"carousel-slide\" data-index=\"3\">\n                            <img src=\"https://assets.willvernon.online/ai/synthetic_corals_2.png\" alt=\"Synthetic Coral 2 - Bioluminescent Cyan Blue\">\n                        </div>\n                        <div class=\"carousel-slide\" data-index=\"4\">\n                            <img src=\"https://assets.willvernon.online/ai/synthetic_corals_4.jpg\" alt=\"Synthetic Coral 4 - Polyps Bouquet\">\n                        </div>\n                        <div class=\"carousel-slide\" data-index=\"5\">\n                            <img src=\"https://assets.willvernon.online/ai/synthetic_corals_5.jpg\" alt=\"Synthetic Coral 5 - Volcanic Coral Graft\">\n                        </div>\n\n                        <!-- Controls -->\n                        <button class=\"carousel-control-btn carousel-prev\" onclick=\"moveCarousel(-1)\" aria-label=\"Previous Slide\">\n                            <i class=\"ph ph-caret-left\"></i>\n                        </button>\n                        <button class=\"carousel-control-btn carousel-next\" onclick=\"moveCarousel(1)\" aria-label=\"Next Slide\">\n                            <i class=\"ph ph-caret-right\"></i>\n                        </button>\n\n                        <!-- Indicators -->\n                        <div class=\"carousel-indicator-row\">\n                            <span class=\"carousel-dot-indicator active\" onclick=\"gotoCarouselSlide(0)\"></span>\n                            <span class=\"carousel-dot-indicator\" onclick=\"gotoCarouselSlide(1)\"></span>\n                            <span class=\"carousel-dot-indicator\" onclick=\"gotoCarouselSlide(2)\"></span>\n                            <span class=\"carousel-dot-indicator\" onclick=\"gotoCarouselSlide(3)\"></span>\n                            <span class=\"carousel-dot-indicator\" onclick=\"gotoCarouselSlide(4)\"></span>\n                            <span class=\"carousel-dot-indicator\" onclick=\"gotoCarouselSlide(5)\"></span>\n                        </div>\n                    </div>\n                ",
    "desc": "An experiment in building a custom ComfyUI workflow to generate imaginary coral reef structures. I was interested in how small changes to the node settings could produce completely different organic forms — one run would give bleached white calcified shapes, the next would produce glowing cyan tendrils. Across five separate test runs the outputs ranged from volcanic rock grafts to delicate bioluminescent polyps, all from the same base pipeline.",
    "prompt": "intricate synthetic coral structures, glowing neon cyan and purple veins, hyper-detailed bioluminescent reef, octane render, complex mathematics organic formations, 8k --ar 16:9 // Node Loader: flux1-dev-fp8.safetensors, shifted ModelSamplingSD3 noise coordinates, KSampler cfg: 4.5, VAE ae.safetensors",
    "engine": "ComfyUI Node + HiDream core (Flux.1 Dev base)",
    "ar": "1:1 / 16:9 Multi-resolutions",
    "style": "Design-Directed Flow (DDF)",
    "upscale": "Upscaled Subtle (Ultrasharp 4x Model)"
   },
   "website_rebuild": {
    "title": "willvernon.online Rebuild",
    "meta": "[ AGENTIC_PAIR // GEMINI_CANVAS ]",
