    "id": "02",
    "title": "Deadly Clout",
    "descShort": "An audio-reactive, dark typographic motion piece. Merges high-frequency sound transients with kinetic grid systems and heavy displacement loops to project a sense of intense digital noise.",
    "mediaSrc": "https://assets.willvernon.online/experiments/DeadlyCloutAV.mp4",
