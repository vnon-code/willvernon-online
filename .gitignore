# Ignore massive audio stems to conform with Cloudflare Workers 25MB limits
audio/*.wav

# System / OS files
.DS_Store
Thumbs.db

# Configuration files
.wrangler/
*.log

# Ignore large media assets to conform with Cloudflare Workers limits
*.mp4
**/*.mp4
*.mov
**/*.mov

# Third-party agent skills (installed per session, never committed — public repo)
.claude/skills/
.agents/
skills-lock.json

# Reference-site screenshots (third-party content, kept local only)
redesign/references/shots/

# Build output and caches (Nuxt; dist/ and .astro/ from the old Astro build)
.nuxt/
.output/
.data/
dist/
.astro/
node_modules/
__pycache__/

# Reference screenshots (third-party content, kept local only)
references/shots/

# Trial / personal-use fonts (licence forbids redistribution)
references/trial-fonts/
# Scratch work stays local, except the v1-launch map and tickets (synced across devices, Will 2026-10-06)
.scratch/*
!.scratch/v1-launch/

# Prototype media pulled from Will's PC (dev only, not deployed; R2 upload pending Will)
public/proto-media/
.scratch/v1-launch/overnight/_src/
