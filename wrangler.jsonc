{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "willvernon-online",
  "compatibility_date": "2026-05-28",
  "observability": {
    "enabled": true
  },
  "build": {
    "command": "npm ci && npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
